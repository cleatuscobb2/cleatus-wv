---
/**
 * §7.1 — the fourteen-item nav moved here, where it can grow.
 *
 * The page opens in the dark with one trip at a time: a photograph, what the
 * trip was and a way in, turning over on its own and steered by the strip of
 * years beneath it. Below, on the pale ground, is every trip as a card with
 * filters and sorting. The script at the bottom adds all the movement; without
 * it this is still the full list, newest first, under the featured trip.
 */
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { fmtRange, chronological, tripIdOf, entrySlug } from '../../lib/entries.ts';
import { firstPhoto } from '../../lib/journey.ts';
import { cover, coverSize, stagePhoto } from '../../lib/covers.ts';
import { COUNTRY_CONTINENT, COUNTRY_NAMES } from '../../data/trip-meta.ts';
import { TAG_ICONS, TAG_LABELS, BETH_CRIED_ICON, type Tag } from '../../data/tags.ts';

const now = new Date();
const trips = (await getCollection('trips')).sort((a, b) => +b.data.dateStart - +a.data.dateStart);
const entries = chronological(await getCollection('entries', (e) => !e.data.draft));

const byTrip = new Map<string, typeof entries>();
for (const e of entries) {
  const id = tripIdOf(e);
  byTrip.set(id, [...(byTrip.get(id) ?? []), e]);
}

/** Up to eight pictures spread across the trip, starting with its cover. */
function photosOf(hero: string | null, list: typeof entries): string[] {
  const all = [...new Set([hero, ...list.map(firstPhoto)].filter((p): p is string => Boolean(p)))];
  if (all.length <= 8) return all;
  return Array.from({ length: 8 }, (_, i) => all[Math.round((i * (all.length - 1)) / 7)]);
}

/** The picture a trip shows large, at the size it will really be drawn. */
function bigPhoto(id: string, hero: string | null) {
  const src = stagePhoto(id, hero);
  if (!src) return null;
  const size = coverSize(src);
  const shrink = size ? Math.min(1, 1800 / Math.max(size.w, size.h)) : 1;
  const w = size ? Math.round(size.w * shrink) : 0;
  const h = size ? Math.round(size.h * shrink) : 0;
  // Only a wide, sharp picture fills the frame; a small one sits in it as a print.
  return { src: cover(src, 'lg'), wash: cover(src), w, h, full: w >= 1000 && w >= h };
}

const DAY = 86_400_000;
const statusOf = (start: Date, end: Date) =>
  +now < +start ? 'upcoming' : +now <= +end + DAY ? 'away' : 'done';

const cards = trips.map((t) => {
  const list = byTrip.get(t.id) ?? [];
  const tags = new Map<Tag, number>();
  for (const e of list) for (const g of e.data.tags) tags.set(g, (tags.get(g) ?? 0) + 1);
  const continents = [...new Set(t.data.countries.map((c) => COUNTRY_CONTINENT[c]).filter(Boolean))];
  const photos = photosOf(t.data.hero, list);
  return {
    t,
    entries: list.length,
    photos: photos.map((p) => cover(p)),
    // The big tile is twice the size of the others, so the cover has a larger copy to hand.
    coverLg: photos[0] ? cover(photos[0], 'lg') : null,
    // A cover that is itself small would only blur at that size.
    sharp: photos[0] ? (coverSize(photos[0])?.w ?? 0) >= 900 : false,
    big: bigPhoto(t.id, t.data.hero),
    startAt: t.data.startHere ? list.find((e) => entrySlug(e) === t.data.startHere) : undefined,
    topTags: [...tags].sort((a, b) => b[1] - a[1]).slice(0, 3).map(([g]) => g),
    cried: list.filter((e) => e.data.bethCried).length,
    continents,
    status: statusOf(t.data.dateStart, t.data.dateEnd),
    daysUntil: Math.ceil((+t.data.dateStart - +now) / DAY),
  };
});

// The running totals count trips that have happened, not plans.
const past = cards.filter((c) => c.status !== 'upcoming');
const countries = new Set(past.flatMap((c) => c.t.data.countries)).size;
const totals = [
  { n: past.length, label: 'trips taken' },
  { n: countries, label: 'countries' },
  { n: past.reduce((s, c) => s + c.t.data.stats.days, 0), label: 'days away' },
  { n: past.reduce((s, c) => s + (c.t.data.stats.trekMiles ?? 0), 0), label: 'miles on foot' },
  { n: Math.max(0, ...past.map((c) => c.t.data.stats.maxElevationFt ?? 0)), label: 'ft, highest' },
].filter((x) => x.n > 0);

const continentCounts = new Map<string, number>();
for (const c of cards) for (const k of c.continents) continentCounts.set(k, (continentCounts.get(k) ?? 0) + 1);
const continentChips = [...continentCounts].sort((a, b) => b[1] - a[1]);

// The timeline: one dot per trip, placed by date between the first year and the last.
const firstYear = Math.min(...trips.map((t) => t.data.dateStart.getUTCFullYear()));
const lastYear = Math.max(...trips.map((t) => t.data.dateEnd.getUTCFullYear()), now.getUTCFullYear());
const span0 = Date.UTC(firstYear, 0, 1);
const span = Date.UTC(lastYear + 1, 0, 1) - span0;
const at = (d: Date) => ((+d - span0) / span) * 100;
const years = Array.from({ length: lastYear - firstYear + 1 }, (_, i) => firstYear + i);
const tripYears = new Set(trips.flatMap((t) => [t.data.dateStart.getUTCFullYear(), t.data.dateEnd.getUTCFullYear()]));
// Trips close together go on separate lanes so their dots don't sit on each other.
const laneEnds: number[] = [];
const dots = [...cards].sort((a, b) => +a.t.data.dateStart - +b.t.data.dateStart).map((c) => {
  const left = at(c.t.data.dateStart);
  const width = Math.max(at(c.t.data.dateEnd) - left, 0);
  let lane = laneEnds.findIndex((end) => end + 3 < left);
  if (lane === -1) { lane = laneEnds.length; laneEnds.push(0); }
  laneEnds[lane] = left + width;
  return { c, left, width, lane };
});

// The stage runs oldest to newest, the way the years read, and opens on the featured trip.
const slides = dots.map((d) => d.c);
const opensOn = Math.max(
  0,
  slides.findIndex((c) => c.t.data.featured && c.big) !== -1
    ? slides.findIndex((c) => c.t.data.featured && c.big)
    : slides.findLastIndex((c) => c.status !== 'upcoming' && c.big),
);

const fmtN = (n: number) => n.toLocaleString('en-US');
const nameOf = (code: string) => COUNTRY_NAMES[code] ?? code;
const soonText = (c: (typeof cards)[number]) =>
  c.status === 'away' ? 'Away now' : c.daysUntil === 1 ? 'Tomorrow' : `In ${c.daysUntil} days`;
---

<Base
  title="Trips"
  description="Fifteen years of long, hard trips — Pakistan's Karakoram, Patagonia, the Himalaya, Borneo, the Galápagos and more, 2009 to now."
>
  <div class="top">
    <div class="top__in">
      <header class="head">
        <div class="head__words">
          <h1 class="display">Trips</h1>
          <p class="head__note">
            {trips.length} trips since {firstYear}. Each one reads forward from day one.
          </p>
        </div>
        <dl class="totals">
          {totals.map((x) => (
            <div class="totals__item">
              <dt class="mono">{x.label}</dt>
              <dd class="display">{fmtN(x.n)}</dd>
            </div>
          ))}
        </dl>
      </header>

      <section class="stage" data-stage data-opens={opensOn} aria-roledescription="carousel" aria-label="The trips, one at a time">
        <div class="stage__frame" data-frame>
          {[0, 1].map((k) => {
            const first = k === 0 ? slides[opensOn] : null;
            const b = first?.big;
            return (
              <div
                class:list={['layer', { 'is-on': k === 0, 'layer--full': b?.full, 'layer--print': b && !b.full }]}
                style={b && !b.full ? `--nw: ${b.w}; --nh: ${b.h}` : undefined}
                data-layer
              >
                {b && (
                  <>
                    <span class="layer__wash" style={`background-image: url("${b.wash}")`} />
                    <img class="layer__img" src={b.src} alt="" fetchpriority="high" decoding="async" />
                  </>
                )}
              </div>
            );
          })}
          <span class="stage__progress" data-progress aria-hidden="true" />
        </div>

        <div class="stage__words">
          {slides.map((c, i) => {
            const { t } = c;
            const s = t.data.stats;
            const real = t.data.summary && !t.data.summaryNeedsReview;
            return (
              <article
                class="slide"
                data-slide={i}
                data-id={t.id}
                data-photo={c.big?.src}
                data-wash={c.big?.wash}
                hidden={i !== opensOn}
                aria-roledescription="slide"
                aria-label={`${i + 1} of ${slides.length}`}
              >
                <p class="mono slide__kicker">
                  {c.status === 'upcoming' ? 'Up next · ' : c.status === 'away' ? 'On the road · ' : ''}
                  {fmtRange(t.data.dateStart, t.data.dateEnd)} · {s.days} days
                </p>
                <h2 class="display slide__title">{t.data.title}</h2>
                <p class="mono slide__where">{t.data.countries.map(nameOf).join(' · ')}</p>
                {real && <p class="slide__sum">{t.data.summary}</p>}
                <p class="mono slide__facts">
                  {[
                    c.entries ? `${c.entries} ${c.entries === 1 ? 'entry' : 'entries'}` : 'Nothing written yet',
                    s.trekMiles ? `${s.trekMiles} mi on foot` : null,
                    s.maxElevationFt ? `${fmtN(s.maxElevationFt)} ft` : null,
                  ].filter(Boolean).join(' · ')}
                </p>
                {(c.topTags.length > 0 || c.cried > 0) && (
                  <p class="slide__marks mono">
                    {c.topTags.map((g) => <span><span aria-hidden="true">{TAG_ICONS[g]}</span> {TAG_LABELS[g]}</span>)}
                    {c.cried > 0 && <span><span aria-hidden="true">{BETH_CRIED_ICON}</span> Beth cried ×{c.cried}</span>}
                  </p>
                )}
                <p class="slide__go">
                  <a class="btn btn--main mono" href={`/${t.id}/`}>Open the trip <span aria-hidden="true">→</span></a>
                  {c.startAt && (
                    <a class="btn mono" href={`/${t.id}/${entrySlug(c.startAt)}/`}>
                      <span>Start here</span><span class="btn__more">— {c.startAt.data.title}</span>
                    </a>
                  )}
                </p>
                {!c.big && (
                  <template data-blank>
                    {c.status === 'done' ? (
                      <div class="blank blank--none">
                        <span class="display blank__big">{t.data.countries.map(nameOf).join(' · ')}</span>
                        <span class="mono">No photographs from this one</span>
                      </div>
                    ) : (
                      <div class="blank blank--soon">
                        <span class="mono blank__kicker">{c.status === 'away' ? 'On the road' : 'Up next'}</span>
                        <span class="display blank__big" data-countdown={+t.data.dateStart} data-until={+t.data.dateEnd}>{soonText(c)}</span>
                        <span class="mono blank__clock" data-clock={+t.data.dateStart} />
                        <span class="mono blank__where">{t.data.countries.map(nameOf).join(' · ')}</span>
                      </div>
                    )}
                  </template>
                )}
              </article>
            );
          })}
          <article class="slide slide--dice" data-dice-slide hidden aria-live="polite">
            <p class="mono slide__kicker"><span aria-hidden="true">🎲</span> A day at random</p>
            <h2 class="display slide__title" data-dice-title></h2>
            <p class="mono slide__where" data-dice-where></p>
            <p class="slide__go">
              <a class="btn btn--main mono" href="/archive/" data-dice-go>Read this day <span aria-hidden="true">→</span></a>
              <button type="button" class="btn mono" data-dice>Roll again</button>
            </p>
          </article>

          <div class="stage__bar" data-bar hidden>
            <button type="button" class="ctl" data-prev aria-label="Earlier trip"><span aria-hidden="true">←</span></button>
            <span class="mono stage__count" data-count>{opensOn + 1} / {slides.length}</span>
            <button type="button" class="ctl" data-next aria-label="Later trip"><span aria-hidden="true">→</span></button>
            <button type="button" class="ctl ctl--play" data-play aria-label="Pause"><span aria-hidden="true" data-play-icon>❚❚</span></button>
            <button type="button" class="dice mono" data-dice>
              <span class="dice__face" aria-hidden="true">🎲</span> Take me somewhere
            </button>
          </div>
        </div>
      </section>

      <section class="ribbon" aria-label="The trips in time">
        <div class="ribbon__track" style={`--lanes: ${laneEnds.length}`}>
          {years.map((y) => (
            <span
              class:list={['ribbon__year mono', { 'ribbon__year--empty': !tripYears.has(y) }]}
              style={`left: ${at(new Date(Date.UTC(y, 0, 1)))}%; width: ${100 / years.length}%`}
            >{y}</span>
          ))}
          {dots.map(({ c, left, width, lane }, i) => (
            <a
              href={`#${c.t.id}`}
              class:list={['ribbon__dot', `ribbon__dot--${c.status}`, { 'ribbon__dot--bare': !c.photos.length, 'is-on': i === opensOn }]}
              style={`left: ${left}%; --w: ${width}%; --lane: ${lane}`}
              data-for={c.t.id}
              data-go={i}
            >
              <span class:list={['ribbon__label mono', { 'ribbon__label--left': left > 80, 'ribbon__label--right': left < 12 }]}>
                {c.t.data.shortTitle} <span class="ribbon__when">{c.t.data.dateStart.getUTCFullYear()}</span>
              </span>
            </a>
          ))}
        </div>
      </section>
    </div>
  </div>

  <div class="trips">
    <div class="tools" data-tools hidden>
      <div class="chips" role="group" aria-label="Show trips in">
        <button type="button" class="chip mono" data-where="" aria-pressed="true">Everywhere <span class="chip__n">{cards.length}</span></button>
        {continentChips.map(([k, n]) => (
          <button type="button" class="chip mono" data-where={k} aria-pressed="false">{k} <span class="chip__n">{n}</span></button>
        ))}
      </div>
      <div class="chips" role="group" aria-label="Only trips with">
        <button type="button" class="chip mono" data-only="trek" aria-pressed="false">🥾 A trek</button>
        <button type="button" class="chip mono" data-only="cried" aria-pressed="false">{BETH_CRIED_ICON} Beth cried</button>
      </div>
      <label class="sort mono">
        Sort
        <select data-sort>
          <option value="newest">Newest</option>
          <option value="oldest">Oldest</option>
          <option value="longest">Longest</option>
          <option value="written">Most written</option>
          <option value="countries">Most countries</option>
          <option value="tears">Most tears</option>
        </select>
      </label>
      <p class="tools__count mono" aria-live="polite" data-count></p>
    </div>

    <ol class="grid" data-grid>
      {cards.map((c, i) => {
        const { t } = c;
        const s = t.data.stats;
        return (
          <li
            id={t.id}
            class:list={['trip', `trip--${c.status}`, { 'is-lead': c.sharp && i === cards.findIndex((x) => x.photos.length > 0) }]}
            style={`view-transition-name: trip-${i}`}
            data-start={+t.data.dateStart}
            data-end={+t.data.dateEnd}
            data-days={s.days}
            data-written={c.entries}
            data-countries={t.data.countries.length}
            data-where={c.continents.join('|')}
            data-trek={s.trekMiles ? '1' : ''}
            data-cried={c.cried ? '1' : ''}
            data-tears={c.cried}
            data-sharp={c.sharp ? '1' : ''}
          >
            <a href={`/${t.id}/`} class="trip__link">
              <span class="trip__media" data-photos={c.photos.length > 1 ? JSON.stringify(c.photos) : undefined}>
                {c.photos.length > 0 ? (
                  <>
                    <img
                      src={c.photos[0]}
                      srcset={c.coverLg && c.coverLg !== c.photos[0] ? `${c.photos[0]} 960w, ${c.coverLg} 1800w` : undefined}
                      sizes={c.coverLg && c.coverLg !== c.photos[0] ? '(min-width: 64rem) 25vw, (min-width: 40rem) 50vw, 100vw' : undefined}
                      alt=""
                      loading={i < 3 ? 'eager' : 'lazy'}
                      decoding="async"
                    />
                    {c.photos.length > 1 && (
                      <span class="trip__ticks" aria-hidden="true">
                        {c.photos.map((_, k) => <span class:list={['trip__tick', { on: k === 0 }]} />)}
                      </span>
                    )}
                  </>
                ) : c.status === 'upcoming' || c.status === 'away' ? (
                  <span class="trip__soon">
                    <span class="mono trip__soon-kicker">{c.status === 'away' ? 'On the road' : 'Up next'}</span>
                    <span class="display trip__soon-big" data-countdown={+t.data.dateStart} data-until={+t.data.dateEnd}>{soonText(c)}</span>
                    <span class="mono trip__soon-where">{t.data.countries.map(nameOf).join(' · ')}</span>
                  </span>
                ) : (
                  <span class="trip__none">
                    <span class="display trip__none-where">{t.data.countries.map(nameOf).join(' · ')}</span>
                    <span class="mono">No photographs</span>
                  </span>
                )}
                <span class="trip__year mono" aria-hidden="true">{t.data.dateStart.getUTCFullYear()}</span>
              </span>
              <span class="trip__body">
                <span class="mono trip__dates">{fmtRange(t.data.dateStart, t.data.dateEnd)} · {s.days} days</span>
                <span class="display trip__title">{t.data.title}</span>
                <span class="trip__codes" aria-label={`Countries: ${t.data.countries.map(nameOf).join(', ')}`}>
                  {t.data.countries.map((code) => <abbr class="mono" title={nameOf(code)} aria-hidden="true">{code}</abbr>)}
                </span>
                <span class="mono trip__stats">
                  {[
                    `${c.entries} ${c.entries === 1 ? 'entry' : 'entries'}`,
                    s.trekMiles ? `${s.trekMiles} mi trek` : null,
                    s.maxElevationFt ? `${fmtN(s.maxElevationFt)} ft` : null,
                  ].filter(Boolean).join(' · ')}
                </span>
                {/* Filled in by the script: how this trip measures against the others on the chosen sort. */}
                <span class="trip__meter mono" data-meter hidden>
                  <span class="trip__meter-bar"><span class="trip__meter-fill" /></span>
                  <span data-meter-label></span>
                </span>
                {(c.topTags.length > 0 || c.cried > 0) && (
                  <span class="trip__marks">
                    {c.topTags.map((g) => <span title={TAG_LABELS[g]} aria-label={TAG_LABELS[g]} role="img">{TAG_ICONS[g]}</span>)}
                    {c.cried > 0 && (
                      <span class="trip__cried mono" title={`Beth cried ${c.cried} ${c.cried === 1 ? 'time' : 'times'}`}>
                        <span aria-hidden="true">{BETH_CRIED_ICON}</span> ×{c.cried}<span class="sr"> times Beth cried</span>
                      </span>
                    )}
                  </span>
                )}
              </span>
            </a>
          </li>
        );
      })}
    </ol>
    <p class="none" data-none hidden>
      No trips match that. <button type="button" class="mono" data-clear>Show them all</button>
    </p>
  </div>
</Base>

<script>
  const calm = matchMedia('(prefers-reduced-motion: reduce)');
  const fine = matchMedia('(hover: hover) and (pointer: fine)');

  // ---- the countdown stays true after the page was built ----
  function countdowns(root: ParentNode) {
    root.querySelectorAll<HTMLElement>('[data-countdown]').forEach((el) => {
      const start = Number(el.dataset.countdown);
      const end = Number(el.dataset.until);
      const today = new Date();
      const startDay = new Date(start);
      const days = Math.round((Date.UTC(startDay.getUTCFullYear(), startDay.getUTCMonth(), startDay.getUTCDate()) - Date.UTC(today.getFullYear(), today.getMonth(), today.getDate())) / 86_400_000);
      const kicker = el.parentElement?.querySelector('.trip__soon-kicker, .blank__kicker');
      if (days > 1) el.textContent = `In ${days} days`;
      else if (days === 1) el.textContent = 'Tomorrow';
      else if (Date.now() <= end + 86_400_000) {
        el.textContent = `Day ${1 - days}`;
        if (kicker) kicker.textContent = 'On the road';
      } else {
        el.textContent = 'Just back';
        if (kicker) kicker.textContent = 'Writing it up';
      }
    });
  }
  countdowns(document);

  /** Hours, minutes and seconds to midnight on the day they leave, ticking. */
  let clockTimer = 0;
  function clocks() {
    clearInterval(clockTimer);
    const draw = () => {
      const els = document.querySelectorAll<HTMLElement>('[data-clock]');
      if (!els.length) { clearInterval(clockTimer); return; }
      els.forEach((el) => {
        const d = new Date(Number(el.dataset.clock));
        const left = +new Date(d.getUTCFullYear(), d.getUTCMonth(), d.getUTCDate()) - Date.now();
        if (left <= 0) { el.textContent = ''; return; }
        const two = (n: number) => String(n).padStart(2, '0');
        const sec = Math.floor(left / 1000);
        el.textContent = `${Math.floor(sec / 86400)}d ${two(Math.floor(sec / 3600) % 24)}h ${two(Math.floor(sec / 60) % 60)}m ${two(sec % 60)}s`;
      });
    };
    draw();
    clockTimer = window.setInterval(draw, 1000);
  }

  // ---- the stage: one trip at a time ----
  const stage = document.querySelector<HTMLElement>('[data-stage]');
  if (stage) {
    const frame = stage.querySelector<HTMLElement>('[data-frame]')!;
    const layers = [...frame.querySelectorAll<HTMLElement>('[data-layer]')];
    const progress = frame.querySelector<HTMLElement>('[data-progress]')!;
    const slides = [...stage.querySelectorAll<HTMLElement>('[data-slide]')];
    const diceSlide = stage.querySelector<HTMLElement>('[data-dice-slide]')!;
    const bar = stage.querySelector<HTMLElement>('[data-bar]')!;
    const count = bar.querySelector<HTMLElement>('[data-count]')!;
    const playBtn = bar.querySelector<HTMLButtonElement>('[data-play]')!;
    const playIcon = bar.querySelector<HTMLElement>('[data-play-icon]')!;
    const dots = [...document.querySelectorAll<HTMLAnchorElement>('.ribbon__dot')];
    const DWELL = 7000;
    bar.hidden = false;

    let cur = Number(stage.dataset.opens ?? 0);
    let front = 0;       // which of the two layers is showing
    let paintId = 0;     // so a slow picture can't land after a newer one
    let playing = !calm.matches;
    let timer = 0;
    const held = new Set<string>();

    interface Shot { photo?: string | null; wash?: string | null; blank?: Node | null }

    // Astro scopes this page's styles to the elements it rendered; anything made
    // here has to carry the same mark or the styles pass it by.
    const scope = [...frame.attributes].find((a) => a.name.startsWith('data-astro-cid-'))?.name;
    const make = <K extends keyof HTMLElementTagNameMap>(tag: K, className: string, text?: string) => {
      const el = document.createElement(tag);
      el.className = className;
      if (scope) el.setAttribute(scope, '');
      if (text !== undefined) el.textContent = text;
      return el;
    };

    /** Put a picture (or a trip's no-picture panel) on the back layer, then bring it forward. */
    function paint(shot: Shot) {
      const id = ++paintId;
      const back = layers[1 - front];
      back.replaceChildren();
      back.className = 'layer';
      back.removeAttribute('style');
      const swap = () => {
        if (id !== paintId) return;
        layers[front].classList.remove('is-on');
        back.classList.add('is-on');
        front = 1 - front;
        clocks();
      };
      if (!shot.photo) {
        if (shot.blank) back.append(shot.blank);
        countdowns(back);
        swap();
        return;
      }
      const wash = make('span', 'layer__wash');
      wash.style.backgroundImage = `url("${shot.wash ?? shot.photo}")`;
      const img = make('img', 'layer__img');
      img.alt = '';
      img.decoding = 'async';
      img.src = shot.photo;
      back.append(wash, img);
      const ready = () => {
        // A wide, sharp picture fills the frame. A small one sits in it as a print, never stretched far.
        const w = img.naturalWidth, h = img.naturalHeight;
        if (w >= 1000 && w >= h) back.classList.add('layer--full');
        else {
          back.classList.add('layer--print');
          back.style.setProperty('--nw', String(w || 600));
          back.style.setProperty('--nh', String(h || 400));
        }
        swap();
      };
      img.decode().then(ready, ready);
    }

    const shotOf = (el: HTMLElement): Shot => ({
      photo: el.dataset.photo,
      wash: el.dataset.wash,
      blank: el.querySelector<HTMLTemplateElement>('template[data-blank]')?.content.cloneNode(true),
    });

    function mark(i: number | null) {
      slides.forEach((el, k) => { el.hidden = k !== i; });
      diceSlide.hidden = i !== null;
      dots.forEach((d) => {
        const on = i !== null && Number(d.dataset.go) === i;
        d.classList.toggle('is-on', on);
        if (on) d.setAttribute('aria-current', 'true'); else d.removeAttribute('aria-current');
      });
      count.textContent = i === null ? '🎲' : `${i + 1} / ${slides.length}`;
    }

    function show(i: number) {
      cur = (i + slides.length) % slides.length;
      mark(cur);
      paint(shotOf(slides[cur]));
      // Have the next picture ready before it is asked for.
      const next = slides[(cur + 1) % slides.length].dataset.photo;
      if (next) new Image().src = next;
      arm();
    }

    // -- turning over on its own --
    const running = () => playing && held.size === 0;
    function arm() {
      clearTimeout(timer);
      progress.classList.remove('is-run');
      if (!running()) return;
      void progress.offsetWidth;
      progress.classList.add('is-run');
      timer = window.setTimeout(() => show(cur + 1), DWELL);
    }
    function setPlaying(on: boolean) {
      playing = on;
      playBtn.setAttribute('aria-label', on ? 'Pause' : 'Play');
      playIcon.textContent = on ? '❚❚' : '▶';
      arm();
    }
    const hold = (why: string, on: boolean) => { on ? held.add(why) : held.delete(why); arm(); };
    stage.addEventListener('pointerenter', () => fine.matches && hold('hover', true));
    stage.addEventListener('pointerleave', () => hold('hover', false));
    stage.addEventListener('focusin', () => hold('focus', true));
    stage.addEventListener('focusout', () => hold('focus', false));
    document.addEventListener('visibilitychange', () => hold('tab', document.hidden));
    new IntersectionObserver(([e]) => hold('away', !e.isIntersecting), { threshold: 0.35 }).observe(frame);

    // -- steering it: someone who picks a trip keeps it until they say otherwise --
    const go = (i: number) => { setPlaying(false); show(i); };
    bar.querySelector('[data-prev]')!.addEventListener('click', () => go(cur - 1));
    bar.querySelector('[data-next]')!.addEventListener('click', () => go(cur + 1));
    playBtn.addEventListener('click', () => {
      // Coming back from a random day, play picks up at the trip it left.
      if (!diceSlide.hidden) show(cur);
      setPlaying(!playing);
    });
    stage.addEventListener('keydown', (ev) => {
      if ((ev.target as Element).closest('select, input, textarea')) return;
      if (ev.key === 'ArrowLeft') { ev.preventDefault(); go(cur - 1); }
      if (ev.key === 'ArrowRight') { ev.preventDefault(); go(cur + 1); }
    });
    let downX: number | null = null;
    frame.addEventListener('pointerdown', (ev) => { downX = ev.clientX; });
    frame.addEventListener('pointerup', (ev) => {
      if (downX === null) return;
      const dx = ev.clientX - downX;
      downX = null;
      if (Math.abs(dx) > 40) go(cur + (dx < 0 ? 1 : -1));
    });
    frame.addEventListener('pointercancel', () => { downX = null; });

    // -- the strip of years steers it too, and still lights up the card below --
    dots.forEach((dot) => {
      const li = document.getElementById(dot.dataset.for!);
      dot.addEventListener('pointerenter', () => li?.classList.add('is-hot'));
      dot.addEventListener('pointerleave', () => li?.classList.remove('is-hot'));
      dot.addEventListener('click', (ev) => {
        ev.preventDefault();
        go(Number(dot.dataset.go));
        if (stage.getBoundingClientRect().top < 0) stage.scrollIntoView({ behavior: calm.matches ? 'auto' : 'smooth', block: 'start' });
      });
    });

    // -- somewhere at random: a single day, from any trip --
    type Picks = { trips: [string, string][]; picks: [number, string, string, string, string | null][] };
    let picks: Promise<Picks> | null = null;
    const loadPicks = () => (picks ??= fetch('/picks.json').then((r) => r.json()));
    const diceTitle = diceSlide.querySelector<HTMLElement>('[data-dice-title]')!;
    const diceWhere = diceSlide.querySelector<HTMLElement>('[data-dice-where]')!;
    const diceGo = diceSlide.querySelector<HTMLAnchorElement>('[data-dice-go]')!;
    let rolling = false;
    async function roll() {
      if (rolling) return;
      rolling = true;
      setPlaying(false);
      try {
        const data = await loadPicks();
        const any = () => data.picks[Math.floor(Math.random() * data.picks.length)];
        // Mostly a day with a photograph to land on, but the trips without any still get a turn.
        const withPhoto = data.picks.filter((p) => p[4]);
        const [trip, slug, title, date, photo] = withPhoto.length && Math.random() < 0.85
          ? withPhoto[Math.floor(Math.random() * withPhoto.length)]
          : any();
        const [tripId, tripTitle] = data.trips[trip];
        mark(null);
        diceWhere.textContent = '';
        // Titles flick past before it settles, like a departures board.
        if (!calm.matches) {
          stage.classList.add('is-rolling');
          for (let k = 0; k < 9; k++) {
            diceTitle.textContent = any()[2];
            await new Promise((r) => setTimeout(r, 60 + k * 12));
          }
          stage.classList.remove('is-rolling');
        }
        diceTitle.textContent = title;
        diceWhere.textContent = `${tripTitle} · ${date}`;
        diceGo.href = `/${tripId}/${slug}/`;
        // The strip of years shows which trip the day came from.
        dots.forEach((d) => d.classList.toggle('is-on', d.dataset.for === tripId));
        let blank: Node | null = null;
        if (!photo) {
          blank = make('div', 'blank blank--none');
          blank.appendChild(make('span', 'display blank__big', tripTitle));
          blank.appendChild(make('span', 'mono', 'No photograph on this day'));
        }
        paint({ photo, wash: photo, blank });
      } catch {
        // No list to pick from: the archive is the next best place to wander.
        location.href = '/archive/';
      } finally {
        rolling = false;
      }
    }
    stage.querySelectorAll<HTMLElement>('[data-dice]').forEach((b) => {
      b.addEventListener('click', roll);
      b.addEventListener('pointerenter', loadPicks, { once: true });
      b.addEventListener('focus', loadPicks, { once: true });
    });

    // A link can open the stage on one trip: /trips/?trip=japan-2022
    const asked = slides.findIndex((el) => el.dataset.id === new URLSearchParams(location.search).get('trip'));
    if (asked !== -1 && asked !== cur) go(asked);
    else arm();
    clocks();
  }

  // ---- the cards ----
  const grid = document.querySelector<HTMLOListElement>('[data-grid]');
  const tools = document.querySelector<HTMLElement>('[data-tools]');
  if (grid && tools) {
    const cards = [...grid.querySelectorAll<HTMLLIElement>('.trip')];
    const count = tools.querySelector<HTMLElement>('[data-count]')!;
    const sortBox = tools.querySelector<HTMLSelectElement>('[data-sort]')!;
    const none = document.querySelector<HTMLElement>('[data-none]')!;
    tools.hidden = false;

    // ---- filters and sorting, kept in the address so a view can be shared ----
    const q = new URLSearchParams(location.search);
    const state = {
      where: q.get('where') ?? '',
      only: new Set((q.get('only') ?? '').split(',').filter(Boolean)),
      sort: q.get('sort') ?? 'newest',
    };
    const num = (li: HTMLElement, k: string) => Number(li.dataset[k] ?? 0);
    const SORTS: Record<string, (a: HTMLElement, b: HTMLElement) => number> = {
      newest: (a, b) => num(b, 'start') - num(a, 'start'),
      oldest: (a, b) => num(a, 'start') - num(b, 'start'),
      longest: (a, b) => num(b, 'days') - num(a, 'days'),
      written: (a, b) => num(b, 'written') - num(a, 'written'),
      countries: (a, b) => num(b, 'countries') - num(a, 'countries'),
      tears: (a, b) => num(b, 'tears') - num(a, 'tears'),
    };
    if (!SORTS[state.sort]) state.sort = 'newest';
    // What a sort is measuring, so each card can show how it compares.
    const MEASURES: Record<string, [key: string, one: string, many: string]> = {
      longest: ['days', 'day', 'days'],
      written: ['written', 'entry', 'entries'],
      countries: ['countries', 'country', 'countries'],
      tears: ['tears', 'time Beth cried', 'times Beth cried'],
    };

    const shows = (li: HTMLElement) =>
      (!state.where || (li.dataset.where ?? '').split('|').includes(state.where)) &&
      [...state.only].every((k) => li.dataset[k] === '1');

    function apply() {
      const order = [...cards].sort((a, b) => SORTS[state.sort](a, b) || num(b, 'start') - num(a, 'start'));
      const measure = MEASURES[state.sort];
      const most = measure ? Math.max(1, ...cards.map((li) => num(li, measure[0]))) : 1;
      let shown = 0;
      let lead = false;
      for (const li of order) {
        const on = shows(li);
        li.hidden = !on;
        if (on) shown++;
        // The first match with photographs gets the big tile, if its cover is sharp enough to carry it.
        const img = li.querySelector<HTMLImageElement>('.trip__media img');
        const first = on && !lead && Boolean(img);
        const isLead = first && li.dataset.sharp === '1';
        li.classList.toggle('is-lead', isLead);
        if (img?.srcset) img.sizes = isLead ? '(min-width: 64rem) 50vw, 100vw' : '(min-width: 64rem) 25vw, (min-width: 40rem) 50vw, 100vw';
        if (first) lead = true;
        const meter = li.querySelector<HTMLElement>('[data-meter]');
        if (meter) {
          meter.hidden = !measure;
          if (measure) {
            const v = num(li, measure[0]);
            meter.style.setProperty('--v', String(v / most));
            meter.querySelector('[data-meter-label]')!.textContent = `${v} ${v === 1 ? measure[1] : measure[2]}`;
          }
        }
        grid!.append(li);
      }
      count.textContent = shown === cards.length ? '' : `${shown} of ${cards.length} trips`;
      none.hidden = shown > 0;
      tools!.querySelectorAll<HTMLButtonElement>('[data-where]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.where === state.where)));
      tools!.querySelectorAll<HTMLButtonElement>('[data-only]').forEach((b) => b.setAttribute('aria-pressed', String(state.only.has(b.dataset.only!))));
      sortBox.value = state.sort;
      document.querySelectorAll<HTMLElement>('.ribbon__dot').forEach((d) => {
        const li = document.getElementById(d.dataset.for!);
        d.classList.toggle('is-out', Boolean(li?.hidden));
      });
      const out = new URLSearchParams();
      if (state.where) out.set('where', state.where);
      if (state.only.size) out.set('only', [...state.only].join(','));
      if (state.sort !== 'newest') out.set('sort', state.sort);
      const qs = out.toString();
      history.replaceState(history.state, '', `${location.pathname}${qs ? `?${qs}` : ''}${location.hash}`);
    }
    // Cards slide to their new places where the browser can animate it.
    const change = (fn: () => void) => {
      fn();
      const doc = document as Document & { startViewTransition?: (cb: () => void) => unknown };
      if (doc.startViewTransition && !calm.matches) doc.startViewTransition(apply);
      else apply();
    };

    tools.addEventListener('click', (ev) => {
      const b = (ev.target as Element).closest<HTMLButtonElement>('button');
      if (!b) return;
      if (b.dataset.where !== undefined) change(() => { state.where = b.dataset.where!; });
      if (b.dataset.only) change(() => { const k = b.dataset.only!; state.only.has(k) ? state.only.delete(k) : state.only.add(k); });
    });
    sortBox.addEventListener('change', () => change(() => { state.sort = sortBox.value; }));
    none.querySelector('[data-clear]')!.addEventListener('click', () => change(() => { state.where = ''; state.only.clear(); }));
    apply();

    // ---- flip through a trip's photographs by moving across the picture ----
    grid.querySelectorAll<HTMLElement>('.trip__media[data-photos]').forEach((media) => {
      const photos: string[] = JSON.parse(media.dataset.photos!);
      const img = media.querySelector('img')!;
      const cover = img.getAttribute('srcset');
      const ticks = [...media.querySelectorAll('.trip__tick')];
      // Each is fetched only when someone moves onto it, and the current picture
      // stays up until the next one is ready.
      const ready = new Set([photos[0]]);
      let shown = 0;
      const put = (k: number) => {
        // The cover has a larger copy for the big tile; the others have one size.
        if (k === 0 && cover) img.srcset = cover; else img.removeAttribute('srcset');
        img.src = photos[k];
      };
      const show = (k: number) => {
        if (k === shown) return;
        shown = k;
        ticks.forEach((t, j) => t.classList.toggle('on', j === k));
        const src = photos[k];
        if (ready.has(src)) { put(k); return; }
        const next = new Image();
        next.decoding = 'async';
        next.onload = () => { ready.add(src); if (shown === k) put(k); };
        next.src = src;
      };
      media.addEventListener('pointermove', (ev) => {
        if (!fine.matches) return;
        const r = media.getBoundingClientRect();
        show(Math.min(photos.length - 1, Math.max(0, Math.floor(((ev.clientX - r.left) / r.width) * photos.length))));
      });
      media.addEventListener('pointerleave', () => show(0));
    });

    // ---- a card lights its place on the strip of years ----
    const dotFor = (id: string) => document.querySelector<HTMLElement>(`.ribbon__dot[data-for="${CSS.escape(id)}"]`);
    cards.forEach((li) => {
      li.addEventListener('pointerenter', () => dotFor(li.id)?.classList.add('is-hot'));
      li.addEventListener('pointerleave', () => dotFor(li.id)?.classList.remove('is-hot'));
    });
  }
</script>

