---
/**
 * /admin/entry/[trip]/[slug] — edit an entry's title, prose, photos, draft state.
 * /admin/new                 — write a new one (same editor, plus trip, date,
 *                              day, byline and web address).
 *
 * The text as it's stored (Markdown, plus <Photo>, <PullQuote> and <Aside>) in a
 * plain textarea, with the page preview beside it, checked as you type. Not
 * contenteditable on the rendered page: saving edited HTML back to MDX is a
 * lossy conversion, and the prose is the asset (ADMIN-PLAN.md §4).
 *
 * Photographs are shrunk and re-encoded in the browser (which also drops their
 * EXIF, GPS included), cleaned again by the server, held until save, and
 * committed in the same commit as the text.
 */
import AdminLayout from '../AdminLayout.astro';
import { getStore } from '../store/index.ts';
import { guard, notFound, userOf } from '../guard.ts';
import { HOSTED } from '../mode.ts';
import { readMeta } from '../frontmatter.ts';
import { readTrip } from '../trip-edit.ts';
import { checkBody, renderPreview, splitEntry } from '../mdx.ts';

export const prerender = false;

const blocked = guard(Astro.request);
if (blocked) return blocked;
const user = HOSTED ? userOf(Astro.request) : null;
const store = getStore();

const { trip: tripParam, slug: slugParam } = Astro.params;
const isNew = !tripParam && !slugParam;
if (!isNew && (!tripParam || !slugParam || !/^[a-z0-9-]+$/.test(tripParam) || !/^[a-z0-9-]+$/.test(slugParam))) return notFound();

const tripPaths = await store.list('src/content/trips', '.mdx');
const trips = (await Promise.all(tripPaths.map(async (p) => {
  const m = readTrip((await store.read(p)).text);
  return { id: p.split('/').pop()!.replace(/\.mdx$/, ''), short: m.shortTitle, start: m.dateStart };
}))).sort((a, b) => b.start.localeCompare(a.start));

let path = '';
let version = '';
let meta = { title: '', date: new Date().toISOString().slice(0, 10), day: null as number | null, draft: false, authors: ['beth'] as string[] };
let body = '';
let existingPhotos: string[] = [];
const takenSlugs: Record<string, string[]> = {};

if (isNew) {
  // Every web address already used, per trip, so a new one is unique before it's saved.
  for (const p of await store.list('src/content/entries', '.mdx')) {
    const [, , , t, f] = p.split('/');
    (takenSlugs[t] ??= []).push(f.replace(/\.mdx$/, ''));
  }
} else {
  path = `src/content/entries/${tripParam}/${slugParam}.mdx`;
  let file;
  try { file = await store.read(path); } catch { return notFound(); }
  version = file.version;
  const m = readMeta(file.text);
  meta = { title: m.title, date: m.date, day: m.day, draft: m.draft, authors: m.authors };
  body = splitEntry(file.text).body;
  existingPhotos = await store.listDir(`assets/photos/${tripParam}/${slugParam}`);
}

const tripShort = trips.find((t) => t.id === tripParam)?.short ?? tripParam;
const first = checkBody(body);
const saveLabel = HOSTED ? 'Review & publish' : 'Review & save';
const byKey = meta.authors.includes('andy') && meta.authors.includes('beth') ? 'both' : meta.authors.includes('andy') ? 'andy' : 'beth';

const payload = JSON.stringify({
  hosted: HOSTED, isNew, path, version, title: meta.title, body, draft: meta.draft,
  trip: tripParam ?? trips[0]?.id ?? '', slug: slugParam ?? '', existingPhotos, takenSlugs,
}).replace(/</g, '\\u003c');
---

<AdminLayout title={isNew ? 'New entry' : `${meta.title} — Edit`} current={isNew ? 'new' : 'curate'} user={user}>
  {isNew ? (
    <h1 class="ad-h1 ee-h1">New entry</h1>
  ) : (
    <p class="mono ee-back"><a href="/admin/curate">← Tags &amp; bylines</a> · {tripShort} · {meta.date}{meta.day != null && ` · Day ${meta.day}`}</p>
  )}

  <label class="ee-title">
    <span class="mono">Title</span>
    <input id="f-title" value={meta.title} maxlength="200" />
  </label>

  {isNew && (
    <div class="ee-meta">
      <label class="ee-field"><span class="mono">Trip</span>
        <select id="f-trip">{trips.map((t) => <option value={t.id}>{t.short}</option>)}</select>
      </label>
      <label class="ee-field"><span class="mono">Date</span><input type="date" id="f-date" value={meta.date} /></label>
      <label class="ee-field ee-field--day"><span class="mono">Trek day <em>(optional)</em></span><input type="number" id="f-day" min="1" max="999" /></label>
      <label class="ee-field"><span class="mono">By</span>
        <select id="f-by">
          <option value="beth">Beth</option><option value="andy">Andy</option><option value="both">Both</option>
        </select>
      </label>
      <label class="ee-field ee-field--slug"><span class="mono">Web address</span>
        <span class="ee-slug"><span class="mono" id="slug-prefix"></span><input id="f-slug" pattern="[a-z0-9-]+" maxlength="80" /></span>
      </label>
    </div>
  )}

  <div class="ee-panes">
    <section class="ee-pane" aria-labelledby="ee-src-h">
      <div class="ee-pane__bar">
        <h2 class="mono" id="ee-src-h">Text</h2>
        <details class="ee-help">
          <summary class="mono">Formatting</summary>
          <dl>
            <dt><code>**bold**</code> <code>*italic*</code></dt><dd>Emphasis</dd>
            <dt><code>## Heading</code></dt><dd>A heading (own line)</dd>
            <dt><code>&gt; text</code></dt><dd>An indented quote</dd>
            <dt><code>[words](https://…)</code></dt><dd>A link</dd>
            <dt><code>&lt;Photo src="/photos/…" caption="…" /&gt;</code></dt><dd>A photograph — easiest with <strong>Add photos</strong> below. <code>size="text|wide|full"</code> is optional.</dd>
            <dt><code>&lt;PullQuote attribution="Beth"&gt;…&lt;/PullQuote&gt;</code></dt><dd>A big pulled-out quote</dd>
            <dt><code>&lt;Aside term="Porter"&gt;…&lt;/Aside&gt;</code></dt><dd>A boxed side note</dd>
            <dt><code>\{</code> <code>\}</code> <code>\&lt;</code></dt><dd>To show a brace or a &lt; as plain text</dd>
          </dl>
        </details>
      </div>
      <textarea id="f-body" spellcheck="true" aria-labelledby="ee-src-h" aria-describedby="ee-problems" placeholder={isNew ? 'Write here. A blank line starts a new paragraph.' : undefined}>{body}</textarea>
      <ul class="ee-problems" id="ee-problems" aria-live="polite"></ul>

      <div class="ee-photos" id="ee-drop">
        <label class="btn ee-add">
          Add photos
          <input type="file" id="f-photos" accept="image/jpeg,image/png,image/webp,image/heic,image/heif" multiple />
        </label>
        <span class="ee-photos__help">or drop them here. They go in where the cursor is, in the order they were taken.</span>
        <ul class="ee-uploads" id="ee-uploads" aria-live="polite"></ul>
      </div>
    </section>

    <section class="ee-pane" aria-labelledby="ee-prev-h">
      <div class="ee-pane__bar">
        <h2 class="mono" id="ee-prev-h">Preview</h2>
        {!isNew && !meta.draft && <a class="mono" href={`/${tripParam}/${slugParam}/`} target="_blank" rel="noopener">Live page ↗</a>}
      </div>
      <div class="ee-preview" tabindex="0" role="region" aria-label="How the page will look (scrollable)">
        <h1 class="ee-preview__title" id="ee-preview-title">{meta.title || 'Untitled'}</h1>
        <div class="prose-entry" id="ee-preview" set:html={first.tree ? renderPreview(first.tree) : ''}></div>
      </div>
    </section>
  </div>

  <div class="ee-foot">
    <span class="mono" id="ee-dirty">No unsaved changes</span>
    <label class="mono ee-draft"><input type="checkbox" id="f-draft" checked={meta.draft} /> Draft — not on the site</label>
    <button type="button" id="ee-review" class="btn btn--primary" disabled>{saveLabel}</button>
    <span class="ee-sep"></span>
    <span class="mono ee-note" id="ee-note" aria-live="polite"></span>
  </div>

  <dialog id="ee-dialog" aria-labelledby="ee-dialog-h">
    <h2 id="ee-dialog-h" class="ad-h1 dlg-h">Check your changes</h2>
    <p class="mono ee-legend"><span class="ee-add-l">added</span> <span class="ee-del-l">removed</span></p>
    <div id="ee-diff" class="ee-diff"></div>
    <p class="dlg-err" id="ee-error" role="alert"></p>
    <div class="dlg-actions">
      <button type="button" id="ee-cancel" class="btn">Keep editing</button>
      <button type="button" id="ee-commit" class="btn btn--primary">{HOSTED ? 'Publish' : 'Save as one commit'}</button>
    </div>
  </dialog>

  <script type="application/json" id="entry-data" set:html={payload}></script>
</AdminLayout>

<script>
  import { diffLines, diffWordsWithSpace } from 'diff';
  import { prepare, captureTime, stemOf } from '../photo-client.ts';

  interface Problem { line: number | null; message: string }
  const data = JSON.parse(document.getElementById('entry-data')!.textContent!) as {
    hosted: boolean; isNew: boolean; path: string; version: string; title: string; body: string; draft: boolean;
    trip: string; slug: string; existingPhotos: string[]; takenSlugs: Record<string, string[]>;
  };
  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const esc = (s: string) =>
    s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);
  const FLASH = 'ee-flash';

  const titleEl = $<HTMLInputElement>('f-title');
  const bodyEl = $<HTMLTextAreaElement>('f-body');
  const draftEl = $<HTMLInputElement>('f-draft');
  let orig = { title: data.title, body: data.body, draft: data.draft };
  let problems: Problem[] = [];
  let pending = 0;
  let uploading = 0;
  let leaving = false;

  /** Photographs uploaded but not yet saved, by their final src. */
  const staged = new Map<string, { token: string; url: string }>();

  const norm = (s: string) => `${s.replace(/\r\n/g, '\n').replace(/\s+$/, '')}\n`;
  const titleNow = () => titleEl.value.replace(/\s+/g, ' ').trim();
  const stagedInBody = () => [...staged.keys()].filter((src) => bodyEl.value.includes(`src="${src}"`));
  const dirty = () => data.isNew
    ? !!(titleNow() || bodyEl.value.trim())
    : titleNow() !== orig.title || norm(bodyEl.value) !== norm(orig.body) || draftEl.checked !== orig.draft || stagedInBody().length > 0;

  // ---- where this entry lives (new entries: from trip + web address) -------
  const slugify = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '').slice(0, 80);
  const f = data.isNew ? {
    trip: $<HTMLSelectElement>('f-trip'), date: $<HTMLInputElement>('f-date'), day: $<HTMLInputElement>('f-day'),
    by: $<HTMLSelectElement>('f-by'), slug: $<HTMLInputElement>('f-slug'),
  } : null;
  let slugTouched = false;

  const tripNow = () => (f ? f.trip.value : data.trip);
  const slugNow = () => (f ? f.slug.value : data.slug);
  const prefix = () => `/photos/${tripNow()}/${slugNow()}/`;
  let lastPrefix = prefix();

  /** A web address not yet used in this trip. */
  function uniqueSlug(base: string) {
    const taken = new Set(data.takenSlugs[tripNow()] ?? []);
    let s = base || 'entry';
    for (let n = 2; taken.has(s); n++) s = `${base}-${n}`;
    return s;
  }

  // Photo paths follow the entry; if the address changes, so do they.
  function followPrefix() {
    const next = prefix();
    if (next === lastPrefix) return;
    if (staged.size) {
      bodyEl.value = bodyEl.value.split(`src="${lastPrefix}`).join(`src="${next}`);
      for (const [src, v] of [...staged]) {
        staged.delete(src);
        staged.set(next + src.slice(lastPrefix.length), v);
      }
      schedulePreview();
    }
    lastPrefix = next;
  }

  if (f) {
    const syncSlug = () => {
      if (!slugTouched) f.slug.value = uniqueSlug(slugify(titleNow()));
      $('slug-prefix').textContent = `/${tripNow()}/`;
      followPrefix();
      refresh();
    };
    titleEl.addEventListener('input', syncSlug);
    f.trip.addEventListener('change', syncSlug);
    f.slug.addEventListener('input', () => {
      slugTouched = true;
      f.slug.value = f.slug.value.toLowerCase().replace(/[^a-z0-9-]/g, '');
      followPrefix();
      refresh();
    });
    syncSlug();
  }

  function slugProblem(): string | null {
    if (!f) return null;
    const s = slugNow();
    if (!s) return 'Give it a title (or a web address).';
    if (!/^[a-z0-9]+(-[a-z0-9]+)*$/.test(s)) return 'The web address can only use a–z, 0–9 and single hyphens.';
    if ((data.takenSlugs[tripNow()] ?? []).includes(s)) return 'That web address is already used in this trip.';
    return null;
  }

  function refresh() {
    const d = dirty();
    const blocker = problems.length
      ? `${problems.length} ${problems.length === 1 ? 'problem' : 'problems'} to fix before saving`
      : slugProblem();
    $('ee-dirty').textContent = blocker ?? (d ? 'Unsaved changes' : 'No unsaved changes');
    $<HTMLButtonElement>('ee-review').disabled = !d || !!blocker || pending > 0 || uploading > 0 || !titleNow() || (data.isNew && !bodyEl.value.trim());
  }

  function showProblems() {
    $('ee-problems').innerHTML = problems.map((p, i) =>
      `<li><button type="button" data-i="${i}">${p.line != null ? `Line ${p.line}` : 'Text'}</button> ${esc(p.message)}</li>`,
    ).join('');
  }

  // Jump to the line a problem is on.
  $('ee-problems').addEventListener('click', (ev) => {
    const i = (ev.target as HTMLElement).closest<HTMLButtonElement>('button[data-i]')?.dataset.i;
    const line = i != null ? problems[Number(i)].line : null;
    if (line == null) return;
    const lines = bodyEl.value.split('\n');
    const start = lines.slice(0, line - 1).reduce((n, l) => n + l.length + 1, 0);
    bodyEl.focus();
    bodyEl.setSelectionRange(start, start + (lines[line - 1]?.length ?? 0));
    const lh = parseFloat(getComputedStyle(bodyEl).lineHeight) || 20;
    bodyEl.scrollTop = Math.max(0, (line - 4) * lh);
  });

  // ---- preview -------------------------------------------------------------
  /** Photos not saved yet aren't on the server: show the browser's own copy. */
  function showStagedPhotos() {
    for (const img of $('ee-preview').querySelectorAll('img')) {
      const s = staged.get(img.getAttribute('src') ?? '');
      if (s) img.src = s.url;
    }
  }

  let timer = 0;
  let seq = 0;
  async function runPreview() {
    const mine = ++seq;
    pending++;
    refresh();
    try {
      const res = await fetch('/api/admin/preview', {
        method: 'POST',
        headers: { 'content-type': 'application/json', 'x-cleatus-admin': '1' },
        body: JSON.stringify({ body: bodyEl.value }),
      });
      const out = await res.json();
      if (mine !== seq) return; // a newer check is already on its way
      problems = out.problems ?? [];
      showProblems();
      if (out.html != null) { $('ee-preview').innerHTML = out.html; showStagedPhotos(); }
      $('ee-preview').classList.toggle('is-stale', out.html == null);
    } catch {
      if (mine === seq) $('ee-problems').innerHTML = '<li>Couldn’t check the text just now — it will try again as you type.</li>';
    } finally {
      pending--;
      refresh();
    }
  }
  function schedulePreview() {
    clearTimeout(timer);
    timer = window.setTimeout(runPreview, 450);
    refresh();
  }
  bodyEl.addEventListener('input', schedulePreview);
  titleEl.addEventListener('input', () => {
    $('ee-preview-title').textContent = titleNow() || 'Untitled';
    refresh();
  });
  draftEl.addEventListener('change', refresh);

  // ---- photographs ---------------------------------------------------------

  /** Next free two-digit number in this entry's folder. */
  function nextNumber() {
    const used = [
      ...data.existingPhotos,
      ...[...bodyEl.value.matchAll(/\/(\d{2,3})-[^/"]+\.(?:jpe?g|png|gif|webp)"/gi)].map((m) => `${m[1]}-`),
      ...[...staged.keys()].map((s) => s.split('/').pop()!),
    ].map((n) => parseInt(n, 10)).filter((n) => !Number.isNaN(n));
    return Math.max(0, ...used) + 1;
  }

  function insertAtCursor(text: string) {
    const v = bodyEl.value;
    const at = document.activeElement === bodyEl || bodyEl.selectionStart ? bodyEl.selectionEnd : v.length;
    const before = v.slice(0, at).replace(/\s*$/, '');
    const after = v.slice(at).replace(/^\s*/, '');
    bodyEl.value = `${before}${before ? '\n\n' : ''}${text}${after ? `\n\n${after}` : '\n'}`;
    const caret = (before ? before.length + 2 : 0) + text.length;
    bodyEl.setSelectionRange(caret, caret);
    schedulePreview();
  }

  async function addPhotos(files: File[]) {
    if (slugProblem()) { $('ee-note').textContent = 'Give the entry a title first — photos are filed under its web address.'; return; }
    const list = $('ee-uploads');
    // Capture order, as the laptop importer does; file date when there's no EXIF.
    const timed = await Promise.all(files.map(async (file) => ({ file, at: (await captureTime(file)) ?? file.lastModified })));
    timed.sort((a, b) => a.at - b.at);

    const lines: string[] = [];
    let n = nextNumber();
    for (const { file } of timed) {
      const li = document.createElement('li');
      li.innerHTML = `<span class="ee-up__name">${esc(file.name)}</span> <span class="mono ee-up__state">shrinking…</span>`;
      list.append(li);
      const state = li.querySelector('.ee-up__state')!;
      uploading++;
      refresh();
      try {
        const jpeg = await prepare(file);
        state.textContent = 'uploading…';
        const res = await fetch('/api/admin/photo', {
          method: 'POST',
          headers: { 'content-type': 'image/jpeg', 'x-cleatus-admin': '1' },
          body: jpeg,
        });
        const out = await res.json().catch(() => ({ error: `HTTP ${res.status}` }));
        if (!res.ok) throw new Error(out.error);
        const src = `${prefix()}${String(n++).padStart(2, '0')}-${stemOf(file.name)}.jpg`;
        const url = URL.createObjectURL(jpeg);
        staged.set(src, { token: out.token, url });
        lines.push(`<Photo src="${src}" caption="" />`);
        li.innerHTML = `<img src="${url}" alt="" /> <span class="ee-up__name">${esc(file.name)}</span> <span class="mono ee-up__state is-ok">added · ${Math.round(out.bytes / 1024)} KB, location data removed</span>`;
      } catch (e) {
        li.classList.add('is-bad');
        state.textContent = (e as Error).message;
      } finally {
        uploading--;
        refresh();
      }
    }
    if (lines.length) insertAtCursor(lines.join('\n\n'));
  }

  $<HTMLInputElement>('f-photos').addEventListener('change', (ev) => {
    const input = ev.target as HTMLInputElement;
    void addPhotos([...(input.files ?? [])]);
    input.value = '';
  });
  const drop = $('ee-drop');
  for (const t of [drop, bodyEl]) {
    t.addEventListener('dragover', (ev) => {
      if (ev.dataTransfer?.types.includes('Files')) { ev.preventDefault(); drop.classList.add('is-over'); }
    });
    t.addEventListener('dragleave', () => drop.classList.remove('is-over'));
    t.addEventListener('drop', (ev) => {
      const files = [...(ev.dataTransfer?.files ?? [])].filter((x) => x.type.startsWith('image/') || /\.(heic|heif)$/i.test(x.name));
      if (!files.length) return;
      ev.preventDefault();
      drop.classList.remove('is-over');
      void addPhotos(files);
    });
  }

  // ---- review & save -------------------------------------------------------
  function diffHtml(a: string, b: string) {
    const parts = diffLines(norm(a), norm(b));
    const out: string[] = [];
    for (let i = 0; i < parts.length; i++) {
      const p = parts[i];
      if (!p.added && !p.removed) {
        // Keep two lines of context either side of each change.
        const lines = p.value.replace(/\n$/, '').split('\n');
        if (lines.length > 5) {
          const head = i > 0 ? lines.slice(0, 2) : [];
          const tail = i < parts.length - 1 ? lines.slice(-2) : [];
          out.push(...head.map((l) => `<div class="ee-ctx">${esc(l) || '&nbsp;'}</div>`));
          out.push(`<div class="ee-gap mono">· · · ${lines.length - head.length - tail.length} unchanged lines · · ·</div>`);
          out.push(...tail.map((l) => `<div class="ee-ctx">${esc(l) || '&nbsp;'}</div>`));
        } else {
          out.push(...lines.map((l) => `<div class="ee-ctx">${esc(l) || '&nbsp;'}</div>`));
        }
        continue;
      }
      // A removed block followed by an added one is an edit: mark the words.
      const next = parts[i + 1];
      if (p.removed && next?.added) {
        const words = diffWordsWithSpace(p.value, next.value);
        out.push(`<div class="ee-chg">${words.map((w) =>
          w.added ? `<ins>${esc(w.value)}</ins>` : w.removed ? `<del>${esc(w.value)}</del>` : esc(w.value),
        ).join('').replace(/\n/g, '<br>')}</div>`);
        i++;
        continue;
      }
      const cls = p.added ? 'ee-chg ee-chg--add' : 'ee-chg ee-chg--del';
      out.push(`<div class="${cls}">${p.added ? '<ins>' : '<del>'}${esc(p.value).replace(/\n/g, '<br>')}${p.added ? '</ins>' : '</del>'}</div>`);
    }
    return out.join('');
  }

  const dialog = $<HTMLDialogElement>('ee-dialog');
  const err = $('ee-error');
  const commitBtn = $<HTMLButtonElement>('ee-commit');

  $('ee-review').addEventListener('click', () => {
    const t = titleNow();
    const photos = stagedInBody();
    const bits: string[] = [];
    if (data.isNew) {
      bits.push(`<p class="ee-titlechg"><span class="mono">New</span> <ins>${esc(t)}</ins> at /${esc(tripNow())}/${esc(slugNow())}/</p>`);
    } else if (t !== orig.title) {
      bits.push(`<p class="ee-titlechg"><span class="mono">Title</span> <del>${esc(orig.title)}</del> → <ins>${esc(t)}</ins></p>`);
    }
    if (draftEl.checked !== orig.draft || data.isNew) {
      bits.push(`<p class="ee-titlechg"><span class="mono">Status</span> ${draftEl.checked ? 'Draft — kept off the site' : '<ins>Published on the site</ins>'}</p>`);
    }
    if (photos.length) {
      bits.push(`<p class="ee-titlechg"><span class="mono">Photos</span> <ins>${photos.length} new</ins></p><div class="ee-thumbs">${photos.map((s) => `<img src="${staged.get(s)!.url}" alt="" />`).join('')}</div>`);
    }
    if (norm(bodyEl.value) !== norm(orig.body)) bits.push(diffHtml(orig.body, bodyEl.value));
    $('ee-diff').innerHTML = bits.join('');
    err.textContent = '';
    dialog.showModal();
  });
  $('ee-cancel').addEventListener('click', () => dialog.close());

  commitBtn.addEventListener('click', async () => {
    commitBtn.disabled = true;
    err.textContent = '';
    try {
      const sent = { title: titleNow(), body: bodyEl.value, draft: draftEl.checked };
      const photos = stagedInBody().map((src) => ({ src, token: staged.get(src)!.token }));
      const res = data.isNew
        ? await fetch('/api/admin/new', {
            method: 'POST',
            headers: { 'content-type': 'application/json', 'x-cleatus-admin': '1' },
            body: JSON.stringify({
              ...sent, photos, trip: tripNow(), slug: slugNow(), date: f!.date.value, day: f!.day.value || null,
              authors: f!.by.value === 'both' ? ['andy', 'beth'] : [f!.by.value],
            }),
          })
        : await fetch('/api/admin/entry', {
            method: 'POST',
            headers: { 'content-type': 'application/json', 'x-cleatus-admin': '1' },
            body: JSON.stringify({ path: data.path, version: data.version, ...sent, photos }),
          });
      const out = await res.json().catch(() => ({ error: `HTTP ${res.status}` }));
      if (res.status === 409) {
        err.textContent = data.isNew
          ? 'Nothing was saved: an entry with that web address — or one of those photo names — already exists. Change the web address and try again.'
          : 'Nothing was saved: someone else changed this entry since the page loaded. Copy your text somewhere safe, reload the page, and make your changes again.';
        return;
      }
      if (res.status === 422) {
        problems = out.problems ?? [];
        showProblems();
        dialog.close();
        refresh();
        return;
      }
      if (!res.ok) { err.textContent = `Nothing was saved: ${out.error}`; return; }

      const note = !out.commit
        ? 'Nothing needed saving.'
        : sent.draft
          ? `Saved as a draft (${out.commit}). It isn't on the site until you untick Draft.`
          : data.hosted
            ? `Published as ${out.commit}. The live site updates in a minute or two.`
            : `Saved on this laptop as ${out.commit}. Publish from the Tags page.`;

      if (data.isNew) {
        // Carry on in the ordinary editor for the entry that now exists.
        try { sessionStorage.setItem(FLASH, `${Date.now()}|${note}`); } catch {}
        leaving = true;
        location.href = out.href;
        return;
      }
      const v = out.versions?.[data.path];
      if (v) data.version = v;
      for (const p of photos) { data.existingPhotos.push(p.src.split('/').pop()!); }
      orig = sent;
      for (const src of photos.map((p) => p.src)) staged.delete(src);
      dialog.close();
      refresh();
      $('ee-note').textContent = note;
    } catch (e) {
      err.textContent = `Nothing was saved: ${(e as Error).message}`;
    } finally {
      commitBtn.disabled = false;
    }
  });

  addEventListener('beforeunload', (e) => {
    if (!leaving && dirty()) { e.preventDefault(); e.returnValue = ''; }
  });

  // Kept briefly rather than read once: under `astro dev` the page reloads
  // itself again just after a save, which would wipe a one-shot message.
  try {
    const [at, ...rest] = (sessionStorage.getItem(FLASH) ?? '').split('|');
    if (at && Date.now() - Number(at) < 15_000) $('ee-note').textContent = rest.join('|');
    else sessionStorage.removeItem(FLASH);
  } catch {}
  refresh();
</script>

