---
/**
 * /admin/comments — read what readers sent, then publish or delete it.
 *
 * Nothing here is public until it's published. Publishing a batch is one
 * commit; the site shows it a minute or two later. Published comments can be
 * taken down again (a commit that deletes the file) — the deletion path a
 * stranger's words need.
 */
import { getCollection } from 'astro:content';
import AdminLayout from '../AdminLayout.astro';
import { getStore } from '../store/index.ts';
import { guard, userOf } from '../guard.ts';
import { HOSTED } from '../mode.ts';
import { pending } from '../comments.ts';

export const prerender = false;

const blocked = guard(Astro.request);
if (blocked) return blocked;
const user = HOSTED ? userOf(Astro.request) : null;

let waiting: Awaited<ReturnType<typeof pending>> = [];
let failed = '';
try { waiting = await pending(); } catch (e) { failed = (e as Error).message; }

const entries = await getCollection('entries');
const titleOf = new Map(entries.map((e) => [`${e.data.trip.id}/${e.id.split('/').pop()}`, e.data.title]));

// Published comments, newest first, read through the store so a just-published one shows.
const store = getStore();
const paths = await store.list('src/content/comments', '.json').catch(() => []);
const published = (await Promise.all(paths.map(async (path) => {
  try {
    const { text, version } = await store.read(path);
    const c = JSON.parse(text);
    return { path, version, entry: String(c.entry), name: String(c.name), date: String(c.date), body: String(c.body), archival: !!c.archival };
  } catch { return null; }
}))).filter((c) => c !== null).sort((a, b) => b!.date.localeCompare(a!.date)).slice(0, 50);

const when = (iso: string) =>
  new Date(iso).toLocaleString('en-GB', { day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit', timeZone: 'America/Los_Angeles' });
const saveWord = HOSTED ? 'Publish' : 'Save';
---

<AdminLayout title="Comments" current="comments" user={user}>
  <h1 class="ad-h1">Comments</h1>
  <p class="ad-lede">
    What readers have sent. Nothing appears on the site until one of you publishes it.
    Names and words only — no email addresses are collected.
  </p>

  {failed && <p class="cm-empty">The waiting comments couldn't be read just now ({failed}).</p>}

  <section class="cm-sec" aria-labelledby="cm-wait-h">
    <div class="cm-bar">
      <h2 class="cm-h" id="cm-wait-h">Waiting <span class="mono cm-count">{waiting.length}</span></h2>
      {waiting.length > 0 && (
        <div class="cm-actions">
          <label class="mono cm-all"><input type="checkbox" id="cm-all" /> Select all</label>
          <button type="button" class="btn btn--primary" id="cm-publish" disabled>{saveWord} selected</button>
          <button type="button" class="btn" id="cm-delete" disabled>Delete selected</button>
        </div>
      )}
    </div>
    <p class="mono cm-note" id="cm-note" role="status"></p>

    {waiting.length === 0 ? (
      <p class="cm-empty">Nothing waiting.</p>
    ) : (
      <ul class="cm-list" id="cm-wait">
        {waiting.map((c) => (
          <li class="cm-card" data-id={c.id}>
            <label class="cm-pick">
              <input type="checkbox" class="cm-check" value={c.id} aria-label={`Select the comment from ${c.name}`} />
            </label>
            <div class="cm-main">
              <p class="cm-meta">
                <strong>{c.name}</strong>
                <span class="mono">{when(c.date)}</span>
                <span class="cm-on">on <a href={`/${c.entry}/`} target="_blank" rel="noopener">{titleOf.get(c.entry) ?? c.entry}</a></span>
              </p>
              <p class="cm-body">{c.body}</p>
            </div>
          </li>
        ))}
      </ul>
    )}
  </section>

  <section class="cm-sec" aria-labelledby="cm-pub-h">
    <h2 class="cm-h" id="cm-pub-h">Published <span class="mono cm-count">{paths.length}</span></h2>
    {published.length === 0 ? (
      <p class="cm-empty">None yet.</p>
    ) : (
      <ul class="cm-list">
        {published.map((c) => (
          <li class="cm-card cm-card--pub" data-path={c.path} data-version={c.version}>
            <div class="cm-main">
              <p class="cm-meta">
                <strong>{c.name}</strong>
                <span class="mono">{when(c.date)}{c.archival && ' · from the old site'}</span>
                <span class="cm-on">on <a href={`/${c.entry}/#comments`} target="_blank" rel="noopener">{titleOf.get(c.entry) ?? c.entry}</a></span>
              </p>
              <p class="cm-body">{c.body}</p>
            </div>
            <button type="button" class="btn cm-remove" aria-label={`Take down the comment from ${c.name}`}>Take down</button>
          </li>
        ))}
      </ul>
    )}
  </section>

  <script type="application/json" id="cm-data" set:html={JSON.stringify({ hosted: HOSTED })}></script>
</AdminLayout>

<script>
  const hosted = JSON.parse(document.getElementById('cm-data')!.textContent!).hosted as boolean;
  const note = document.getElementById('cm-note')!;
  const checks = () => [...document.querySelectorAll<HTMLInputElement>('.cm-check')];
  const chosen = () => checks().filter((c) => c.checked).map((c) => c.value);
  const publishBtn = document.getElementById('cm-publish') as HTMLButtonElement | null;
  const deleteBtn = document.getElementById('cm-delete') as HTMLButtonElement | null;
  const all = document.getElementById('cm-all') as HTMLInputElement | null;

  function refresh() {
    const n = chosen().length;
    if (publishBtn) { publishBtn.disabled = n === 0; publishBtn.textContent = `${hosted ? 'Publish' : 'Save'} selected${n ? ` (${n})` : ''}`; }
    if (deleteBtn) { deleteBtn.disabled = n === 0; deleteBtn.textContent = `Delete selected${n ? ` (${n})` : ''}`; }
    if (all) all.checked = n > 0 && n === checks().length;
  }
  document.getElementById('cm-wait')?.addEventListener('change', refresh);
  all?.addEventListener('change', () => { for (const c of checks()) c.checked = all.checked; refresh(); });

  async function send(body: unknown) {
    const res = await fetch('/api/admin/comments', {
      method: 'POST',
      headers: { 'content-type': 'application/json', 'x-cleatus-admin': '1' },
      body: JSON.stringify(body),
    });
    const out = await res.json().catch(() => ({ error: `HTTP ${res.status}` }));
    if (!res.ok) throw new Error(out.error === 'conflict' ? 'someone changed it in the meantime — reload the page' : out.error);
    return out;
  }
  function removeCards(ids: string[]) {
    for (const id of ids) document.querySelector(`.cm-card[data-id="${CSS.escape(id)}"]`)?.remove();
    const left = checks().length;
    document.querySelector('#cm-wait-h .cm-count')!.textContent = String(left);
    refresh();
  }

  publishBtn?.addEventListener('click', async () => {
    const ids = chosen();
    publishBtn.disabled = true;
    try {
      const out = await send({ action: 'publish', ids });
      removeCards(ids);
      note.textContent = hosted
        ? `Published ${out.published} as ${out.commit}. They appear on the site in a minute or two.`
        : `Saved ${out.published} on this laptop as ${out.commit}. Publish from the Tags page.`;
    } catch (e) { note.textContent = `Nothing was published: ${(e as Error).message}`; refresh(); }
  });

  deleteBtn?.addEventListener('click', async () => {
    const ids = chosen();
    if (!confirm(`Delete ${ids.length} ${ids.length === 1 ? 'comment' : 'comments'} for good? They are not kept anywhere.`)) return;
    deleteBtn.disabled = true;
    try {
      await send({ action: 'delete', ids });
      removeCards(ids);
      note.textContent = `Deleted ${ids.length}.`;
    } catch (e) { note.textContent = `Nothing was deleted: ${(e as Error).message}`; refresh(); }
  });

  for (const btn of document.querySelectorAll<HTMLButtonElement>('.cm-remove')) {
    btn.addEventListener('click', async () => {
      const card = btn.closest<HTMLElement>('.cm-card')!;
      if (!confirm('Take this comment off the site? It is removed from the site’s files; only the git history keeps a record.')) return;
      btn.disabled = true;
      try {
        const out = await send({ action: 'remove', path: card.dataset.path, version: card.dataset.version });
        card.remove();
        note.textContent = `Taken down (${out.commit}). The site updates in a minute or two.`;
      } catch (e) { note.textContent = `Not taken down: ${(e as Error).message}`; btn.disabled = false; }
    });
  }
</script>

<style>
  .cm-sec { margin-top: 2rem; max-width: 56rem; }
  .cm-bar { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 0.75rem; }
  .cm-h { font-family: var(--font-display); font-size: 1.2rem; margin: 0; }
  .cm-count { font-size: 0.75rem; color: var(--color-stone); margin-left: 0.3rem; }
  .cm-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 0.6rem; }
  .cm-actions .btn:not(.btn--primary) { color: var(--color-ink); border-color: var(--color-rule); }
  .cm-all { display: inline-flex; gap: 0.35rem; align-items: center; font-size: 0.6875rem; color: var(--color-stone); }
  .cm-note { font-size: 0.75rem; min-height: 1em; margin: 0.6rem 0 0; text-transform: none; letter-spacing: 0; }
  .cm-empty { color: var(--color-stone); margin: 0.75rem 0 0; }
  .cm-list { list-style: none; margin: 0.75rem 0 0; padding: 0; display: grid; gap: 0.6rem; }
  .cm-card { display: grid; grid-template-columns: auto 1fr; gap: 0.8rem; padding: 0.9rem 1rem; background: var(--color-paper); border: 1px solid var(--color-rule); }
  .cm-card--pub { grid-template-columns: 1fr auto; align-items: start; }
  .cm-card--pub .cm-remove { color: var(--color-ink); border-color: var(--color-rule); }
  .cm-pick input { width: 1.1rem; height: 1.1rem; margin-top: 0.15rem; accent-color: var(--color-rime-on-light); }
  .cm-main { min-width: 0; }
  .cm-meta { margin: 0 0 0.35rem; display: flex; flex-wrap: wrap; gap: 0.25rem 0.8rem; align-items: baseline; font-size: 0.9375rem; }
  .cm-meta .mono { font-size: 0.6875rem; color: var(--color-stone); }
  .cm-on { font-size: 0.875rem; color: var(--color-stone); }
  /* A stranger's text, shown exactly as sent — line breaks kept, nothing interpreted. */
  .cm-body { margin: 0; white-space: pre-wrap; overflow-wrap: anywhere; }
</style>
