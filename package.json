{
  "name": "cleatus-wv",
  "version": "1.0.0",
  "description": "cleatusandthewestvirginian.com — Andy and Beth's travel journal, 2009–present",
  "type": "module",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "dev": "npm run inbox && npm run photos && astro dev",
    "build": "npm run inbox && npm run photos && npm run og && astro build && npm run index",
    "og": "node --experimental-strip-types scripts/og-images.ts",
    "index": "pagefind --site dist && node --experimental-strip-types scripts/sync-search.ts",
    "preview": "astro preview",
    "check": "astro check",
    "photos": "node --experimental-strip-types scripts/link-photos.ts",
    "scrape": "node --experimental-strip-types scripts/scrape.ts",
    "convert": "node --experimental-strip-types scripts/convert.ts",
    "gen:trips": "node --experimental-strip-types scripts/gen-trips.ts",
    "verify": "node --experimental-strip-types scripts/verify-phase0.ts",
    "fonts": "node --experimental-strip-types scripts/copy-fonts.ts",
    "new:entry": "node --experimental-strip-types scripts/new-entry.ts",
    "inbox": "node --experimental-strip-types scripts/promote-inbox.ts",
    "import:photos": "node --experimental-strip-types scripts/import-photos.ts"
  },
  "dependencies": {
    "@astrojs/mdx": "^4.3.14",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^5.18.2",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "d3-geo": "^3.1.1",
    "pagefind": "^1.5.2",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  }
}
