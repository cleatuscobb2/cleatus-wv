---
import '../styles/tokens.css';
import SiteNav from '../components/SiteNav.astro';
import Analytics from '@vercel/analytics/astro';

interface Props {
  title: string;
  /** §7.8 — every page carries one. The old site had none, sitewide. */
  description: string;
  ogImage?: string | null;
  /** JSON-LD, stringified by the caller. */
  jsonLd?: Record<string, unknown> | null;
  noIndex?: boolean;
}

const { title, description, ogImage = null, jsonLd = null, noIndex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://cleatusandthewestvirginian.com');
const fullTitle = title === 'Cleatus and the West Virginian'
  ? title
  : `${title} — Cleatus and the West Virginian`;
const ogUrl = ogImage ? new URL(ogImage, canonical).toString() : null;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.toString()} />
    {noIndex && <meta name="robots" content="noindex" />}

    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.toString()} />
    {ogUrl && <meta property="og:image" content={ogUrl} />}
    <meta name="twitter:card" content={ogUrl ? 'summary_large_image' : 'summary'} />

    <link rel="alternate" type="application/rss+xml" title="Cleatus and the West Virginian" href="/rss.xml" />
    <link rel="preconnect" href="/" />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <a href="#main" class="skip mono">Skip to content</a>
    <SiteNav />
    <main id="main">
      <slot />
    </main>
    <footer class="foot">
      <p class="mono">Andy &amp; Beth · 2009–{new Date().getFullYear()}</p>
      <p class="foot__note">
        Fifteen years of long, hard trips. Written mostly by Beth, mostly while exhausted.
      </p>
      <!-- Places and tags are cross-cutting views; they live here rather than
           crowding the four destinations in the nav. -->
      <nav class="foot__links mono" aria-label="More">
        <a href="/numbers/">By the numbers</a>
        <a href="/places/">Places</a>
        <a href="/tags/">Tags</a>
        <a href="/beth-cried-here/">Beth cried here</a>
        <a href="/search/">Search</a>
        <a href="/rss.xml">RSS</a>
      </nav>
    </footer>

    <!--
      Readership counting. Cookieless and aggregate-only: it can tell you that
      forty people read the Gondogoro La entry from eleven countries, and it
      cannot tell you who any of them are or link one visit to the next. That is
      the trade for asking nothing of the reader — no consent banner, no
      identifier, nothing stored on their machine.

      Deliberately production-only, so `npm run dev` never files fake pageviews
      against the real numbers.
    -->
    {import.meta.env.PROD && <Analytics />}

    <!--
      §7.5 — `/` focuses search from anywhere. A few hundred bytes, and nothing
      depends on it running.
    -->
    <script is:inline>
      addEventListener('keydown', (e) => {
        if (e.key !== '/' || e.metaKey || e.ctrlKey || e.altKey) return;
        const t = e.target;
        if (t instanceof HTMLElement &&
            (t.isContentEditable || /^(INPUT|TEXTAREA|SELECT)$/.test(t.tagName))) return;
        const box = document.querySelector('#search input');
        if (box) { e.preventDefault(); box.focus(); }
        else { e.preventDefault(); location.href = '/search/'; }
      });
    </script>

    <style>
      .skip {
        position: absolute;
        left: -9999px;
        top: 0;
        z-index: 100;
        background: var(--color-headlamp);
        color: var(--color-ink);
        padding: 0.7rem 1rem;
      }
      .skip:focus {
        left: 0;
      }
      .foot {
        margin-top: 5rem;
        padding: 2.5rem clamp(1rem, 4vw, 3rem);
        background: var(--color-ink);
        color: var(--color-stone-on-dark);
      }
      .foot p {
        margin: 0;
      }
      .foot__note {
        margin-top: 0.5rem;
        font-size: 0.9375rem;
        max-width: 46ch;
      }
      .foot__links {
        display: flex;
        flex-wrap: wrap;
        gap: 0.6rem 1.4rem;
        margin-top: 1.5rem;
      }
      .foot__links a {
        color: var(--color-rime);
        text-decoration: none;
        border-bottom: 1px solid transparent;
        transition: border-color 150ms ease;
      }
      .foot__links a:hover {
        border-bottom-color: var(--color-rime);
      }
    </style>
  </body>
</html>
