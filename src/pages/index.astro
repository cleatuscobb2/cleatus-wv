---
import { getCollection } from 'astro:content';
import { Picture, getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import mosaic from '../assets/home-mosaic.png';
import { fmtRange, entriesForTrip, entrySlug } from '../lib/entries.ts';

const trips = (await getCollection('trips')).sort((a, b) => +b.data.dateStart - +a.data.dateStart);
const featured = trips.find((t) => t.data.featured) ?? trips[0];
const rest = trips.filter((t) => t.id !== featured?.id).slice(0, 6);

const featuredEntries = featured ? await entriesForTrip(featured.id) : [];
const start = featured?.data.startHere
  ? featuredEntries.find((e) => entrySlug(e) === featured.data.startHere)
  : featuredEntries[0];

const totalEntries = trips.reduce((n, t) => n + t.data.stats.entries, 0);

/*
 * §7.8 — the mosaic makes a far better share card than the generated one: it is
 * the whole enterprise in a single picture. Rendered once at OG size here so the
 * meta tag points at an optimised file rather than the 9.9 MB original.
 */
const ogMosaic = await getImage({ src: mosaic, width: 1200, height: 670, format: 'jpeg', quality: 82 });

/*
 * The tagline is voice, and voice is theirs — so it lives here as one obvious
 * line to change rather than buried in the markup.
 * Alternatives kept to hand: "Somewhere difficult, since 2009" ·
 * "Fifteen years of doing it the hard way" · "28 countries. 295 entries.
 * One of us cries." · "The long way round, every time"
 */
const TAGLINE = ['We keep picking', 'the hard way'];
---

<Base
  title="Cleatus and the West Virginian"
  description={`Andy and Beth have been taking long, hard trips since 2009 — ${trips.length} of them, ${totalEntries} entries, from the Karakoram to Patagonia. Written mostly by Beth, mostly while exhausted.`}
  ogImage={ogMosaic.src}
>
  {/*
    The mosaic opens the site. Deliberately not a full-viewport hero with the
    title floated over it (§6.4) — it sits in its own dark band, complete and
    uncropped, with the words below it. It is a panelled illustration; cropping
    it to fit a viewport would cut panels off, which is the one thing it cannot
    survive.
  */}
  <div class="mosaic">
    <Picture
      src={mosaic}
      formats={['webp']}
      fallbackFormat="jpeg"
      quality={72}
      widths={[640, 960, 1280, 1600, 2048]}
      sizes="(max-width: 78rem) 100vw, 78rem"
      {/* AVIF is deliberately absent: measured on this image it runs ~15% larger
          than WebP at every size (910 KB vs 779 KB at 2048w), and <picture>
          serves the first supported source, so offering it would hand the
          heavier file to the browsers best able to avoid it. */}
      loading="eager"
      fetchpriority="high"
      decoding="sync"
      alt="An illustrated mosaic of Andy and Beth across fifteen years of trips: hiking a forest trail with packs, scuba diving over a reef, snowboarding, ice climbing roped together, on safari beside a lion, driving a speedboat, dressed up over dinner and champagne, reading a map in front of a city skyline, and mountain biking past a sign reading Biking Death Road."
    />
  </div>

  <section class="lede">
    {/* The explicit space matters: without it the accessible name and any text
        extraction read "pickingthe hard way". */}
    <h1 class="display lede__title">
      {TAGLINE[0]}{' '}<br />{TAGLINE[1]}
    </h1>
    <p class="lede__body">
      Andy and Beth met on a study-abroad trip to Bangalore and have been going
      somewhere difficult ever since. {trips.length} trips, {totalEntries} entries,
      written mostly by Beth — usually the same night, usually exhausted.
    </p>
    <p class="mono lede__links">
      <a href="/trips/">All trips</a> · <a href="/archive/">Archive</a>
    </p>
  </section>

  {featured && (
    <section class="feat">
      <a href={`/${featured.id}/`} class="feat__link">
        {featured.data.hero && (
          <img class="feat__img" src={featured.data.hero} alt="" loading="eager" fetchpriority="high" />
        )}
        <span class="feat__meta mono">
          Most recent · {fmtRange(featured.data.dateStart, featured.data.dateEnd)}
        </span>
        <span class="display feat__title">{featured.data.title}</span>
      </a>
      <p class="feat__sum">{featured.data.summary}</p>
      {start && (
        <p><a href={`/${featured.id}/${entrySlug(start)}/`} class="feat__start">
          <span class="mono">Start here</span> — {start.data.title}
        </a></p>
      )}
    </section>
  )}

  <section class="more">
    <h2 class="mono more__head">Further back</h2>
    <ul>
      {rest.map((t) => (
        <li>
          <a href={`/${t.id}/`}>
            <span class="mono more__year">{t.data.year}</span>
            <span class="more__title">{t.data.title}</span>
          </a>
        </li>
      ))}
    </ul>
    <p><a href="/trips/" class="mono">All {trips.length} trips →</a></p>
  </section>
</Base>

<style>
  /* The mosaic's own stone-tile border is its frame; the dark band gives that
     frame somewhere to sit rather than butting it against the page edge. */
  .mosaic {
    background: var(--color-ink);
    /* A little room at the foot for the intro panel to sit into — kept smaller
       than the panel's negative margin, or the panel lands below the image
       instead of across it. */
    padding: clamp(0.75rem, 2.5vw, 2rem) clamp(0.5rem, 2vw, 2rem) clamp(1rem, 3vw, 2.5rem);
  }
  .mosaic :global(picture),
  .mosaic :global(img) {
    display: block;
    width: 100%;
    height: auto;
    max-width: 78rem;
    margin-inline: auto;
  }

  /*
   * The intro straddles the banner rather than floating on top of it.
   *
   * Text laid directly over this mosaic would be unreadable — it is dense
   * edge-to-edge illustration with no quiet corner that stays quiet across
   * breakpoints. So the intro is a pale panel pulled up over the lower edge of
   * the image: it genuinely overlaps the banner, but carries its own ground, so
   * both the words and the artwork stay legible. The overlap eases off on narrow
   * screens, where there is less image to spare.
   */
  .lede {
    position: relative;
    z-index: 2;
    max-width: 62rem;
    margin: clamp(-7rem, -7vw, -2.5rem) auto 0;
    padding: clamp(1.5rem, 4vw, 2.75rem) clamp(1.25rem, 4vw, 3rem) clamp(1.25rem, 3vw, 2rem);
    background: var(--color-paper);
    border-top: 3px solid var(--color-headlamp);
    box-shadow: 0 -18px 40px rgb(18 22 28 / 0.28);
  }
  .lede__title {
    font-size: clamp(2.6rem, 8vw, 5rem);
    margin: 0;
  }
  .lede__body {
    max-width: 54ch;
    margin: 1.5rem 0 0;
    font-size: 1.1875rem;
  }
  .lede__links {
    margin-top: 1.25rem;
    color: var(--color-stone);
  }

  .feat {
    max-width: 68rem;
    margin: clamp(2.5rem, 6vw, 4rem) auto 0;
    padding-inline: clamp(1rem, 4vw, 3rem);
  }
  .feat__link {
    display: block;
    text-decoration: none;
  }
  .feat__img {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    display: block;
    background: var(--color-rule);
  }
  .feat__meta {
    display: block;
    color: var(--color-stone);
    margin-top: 0.85rem;
    font-size: 0.6875rem;
  }
  .feat__title {
    display: block;
    font-size: clamp(1.7rem, 4vw, 2.6rem);
    margin-top: 0.3rem;
  }
  .feat__link:hover .feat__title {
    text-decoration: underline;
    text-underline-offset: 0.14em;
  }
  .feat__sum {
    max-width: 60ch;
    margin: 0.9rem 0 0;
    color: var(--color-stone);
  }
  .feat__start .mono {
    color: var(--color-stone);
  }

  .more {
    max-width: 68rem;
    margin: clamp(2.5rem, 6vw, 4rem) auto 0;
    padding-inline: clamp(1rem, 4vw, 3rem);
  }
  .more__head {
    color: var(--color-stone);
    margin: 0 0 0.75rem;
  }
  .more ul {
    list-style: none;
    margin: 0 0 1.25rem;
    padding: 0;
    border-top: 1px solid var(--color-rule);
  }
  .more li {
    border-bottom: 1px solid var(--color-rule);
  }
  .more li a {
    display: flex;
    gap: 1.25rem;
    align-items: baseline;
    padding: 0.75rem 0;
    text-decoration: none;
  }
  .more li a:hover .more__title {
    text-decoration: underline;
  }
  .more__year {
    color: var(--color-stone);
    flex: 0 0 3.5rem;
  }
  .more__title {
    font-size: 1.0625rem;
  }
</style>
