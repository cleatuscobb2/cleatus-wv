---
/**
 * The overview page — everywhere they've been and everything they've done, in
 * numbers.
 *
 * Every figure comes from `computeMetrics()`, which reads the content itself —
 * and, for where they've been, the travel log in src/data/been-to.ts — so
 * nothing here can drift from the archive. Where the data only partly answers a
 * question, the page says so in its own words rather than presenting a
 * confident wrong number (see the caveats block at the foot).
 */
import Base from '../layouts/Base.astro';
import { computeMetrics } from '../lib/metrics.ts';
import { WORLD } from '../lib/travel.ts';

const m = await computeMetrics();
const t = m.travel;

const n = (x: number) => x.toLocaleString('en-US');
/** "2007, 2009 & 2018" */
const and = (xs: (string | number)[]) =>
  xs.length < 2 ? xs.join('') : `${xs.slice(0, -1).join(', ')} & ${xs[xs.length - 1]}`;
const placeHref = (code: string) => `/places/${code.toLowerCase()}/`;

// Headline figures — the four that describe the whole thing.
const headline = [
  { value: n(m.entries), label: 'entries written' },
  { value: n(m.words), label: 'words' },
  { value: String(t.countries), label: 'countries' },
  { value: String(m.yearsSpanned), label: 'years of writing' },
];

const maxYear = Math.max(...m.byYear.map((y) => y.entries), 1);
const maxTotal = Math.max(...t.years.map((y) => y.total), 1);
const maxVisits = Math.max(...t.mostVisited.map((x) => x.visits), 1);
const topVisited = t.mostVisited.slice(0, 10);
const CONTINENTS = 7;
const short = (from: number, to: number) => (from === to ? String(from) : `${from}–${String(to).slice(-2)}`);
---

<Base
  title="By the numbers"
  description={`${t.countries} countries, ${m.entries} entries, ${n(m.words)} words and ${m.trips} trips written up — everywhere Andy and Beth have been and everything they wrote about it.`}
  ogImage="/og/site.png"
>
  <header class="head">
    <h1 class="display">By the numbers</h1>
    <p class="head__note">
      Everywhere they've been and everything they wrote, counted. The writing is
      read straight out of the archive; the travel comes from their own log of
      every country and month. If neither can answer it, it isn't here.
    </p>
  </header>

  <!-- The instrument panel, the site's dark data surface. -->
  <section class="headline" aria-label="Headline figures">
    <dl>
      {headline.map((h) => (
        <div>
          <dd class="mono headline__v">{h.value}</dd>
          <dt class="mono headline__l">{h.label}</dt>
        </div>
      ))}
    </dl>
  </section>

  <section class="band" aria-label="The count">
    <h2 class="mono band__head">The count</h2>
    <ul class="facts">
      <li><span class="mono facts__v">{t.countries}</span><span class="facts__l">countries — about {t.shareOfWorld}% of the world's {WORLD}; {t.writtenUp} of them <a href="/map/">written up here</a></span></li>
      <li><span class="mono facts__v">{t.continents.length} / {CONTINENTS}</span><span class="facts__l">continents{!t.continents.some((c) => c.name === 'Antarctica') && ' — Antarctica is still waiting'}</span></li>
      <li><span class="mono facts__v">{t.visits}</span><span class="facts__l">country-visits, over {t.monthsAway} months away from home</span></li>
      <li><span class="mono facts__v">{t.returnedTo}</span><span class="facts__l">countries they've been back to at least once</span></li>
      {t.first && (
        <li><span class="mono facts__v">{t.first.when.slice(-4)}</span><span class="facts__l">the first stamp — {t.first.place.name}, {t.first.when}</span></li>
      )}
      {t.newest && (
        <li><span class="mono facts__v">{t.newest.when.slice(-4)}</span><span class="facts__l">the newest — {t.newest.place.name}, {t.newest.when}</span></li>
      )}
      {t.busiestYear && (
        <li><span class="mono facts__v">{t.busiestYear.year}</span><span class="facts__l">busiest year — {t.busiestYear.countries} countries in twelve months</span></li>
      )}
      {t.bestNewYear && (
        <li><span class="mono facts__v">+{t.bestNewYear.fresh}</span><span class="facts__l">most new countries in one year — {t.bestNewYear.years.length > 1 ? `managed ${t.bestNewYear.years.length} times: ${and(t.bestNewYear.years)}` : t.bestNewYear.years[0]}</span></li>
      )}
      {t.favouriteMonth && (
        <li><span class="mono facts__v">{t.favouriteMonth.month}</span><span class="facts__l">favourite month to be away — {t.favouriteMonth.times} of them</span></li>
      )}
      {t.drought && (
        <li><span class="mono facts__v">{t.drought.years} {t.drought.years === 1 ? 'year' : 'years'}</span><span class="facts__l">longest stretch of travelling with no new country, {short(t.drought.from, t.drought.to)}</span></li>
      )}
    </ul>
  </section>

  <section class="band" aria-label="Country count, year by year">
    <h2 class="mono band__head">The count, year by year</h2>
    <ol class="cum">
      {t.years.map((y) => (
        <li class:list={['cum__row', { 'cum__row--gap': y.gap || !y.visited }]}>
          <span class="mono cum__y">{y.label}</span>
          <span class="cum__bar" aria-hidden="true">
            <span class="cum__old" style={`--w:${((y.total - y.fresh.length) / maxTotal) * 100}%`}></span>
            {y.fresh.length > 0 && <span class="cum__new" style={`--w:${(y.fresh.length / maxTotal) * 100}%`}></span>}
          </span>
          <span class="mono cum__n">{y.fresh.length > 0 && <span class="cum__plus">+{y.fresh.length}</span>}{y.total}</span>
          <span class="cum__names">
            {y.fresh.length > 0
              ? y.fresh.map((p, i) => <>{i > 0 && ', '}{p.written ? <a href={placeHref(p.code)}>{p.name}</a> : p.name}</>)
              : y.visited > 0
                ? `${y.visited} ${y.visited === 1 ? 'country' : 'countries'}, none of them new`
                : 'no travel logged'}
          </span>
        </li>
      ))}
    </ol>
    <p class="mono band__note">
      The pale bar is the running total; the dark end is what that year added.
      {t.undated.length > 0 && ` ${and(t.undated.map((p) => p.name))} aren't dated, so the chart ends at ${t.countries - t.undated.length}, not ${t.countries}.`}
    </p>
  </section>

  <section class="band" aria-label="Stamps in the passport">
    <h2 class="mono band__head">Stamps in the passport</h2>
    <div class="stamps">
      {t.flags.map((f) => (
        <div class="stamp">
          <p class="mono stamp__v">{f.places.length}</p>
          <p class="stamp__l">{f.label}</p>
          <ul>{f.places.map((p) => <li>{p.written ? <a href={placeHref(p.code)}>{p.name}</a> : p.name}</li>)}</ul>
        </div>
      ))}
    </div>
  </section>

  {topVisited.length > 0 && (
    <section class="band" aria-label="Where they keep going back">
      <h2 class="mono band__head">Where they keep going back</h2>
      <ol class="years most">
        {topVisited.map((x) => (
          <li>
            <span class="most__name">{x.place.written ? <a href={placeHref(x.place.code)}>{x.place.name}</a> : x.place.name}</span>
            <span class="years__bar" style={`--w:${(x.visits / maxVisits) * 100}%`} aria-hidden="true"></span>
            <span class="mono years__n">{x.visits}</span>
            <span class="mono most__yrs">{x.years}</span>
          </li>
        ))}
      </ol>
      <p class="mono band__note">
        Visits are months: France in June and again in August is two.
        {t.mostVisited.length > topVisited.length && ` ${t.mostVisited.length - topVisited.length} more countries have had a second visit.`}
      </p>
    </section>
  )}

  <section class="band" aria-label="On the road">
    <h2 class="mono band__head">On the road — the written-up trips</h2>
    <ul class="facts">
      <li><span class="mono facts__v">{n(m.daysOnTheRoad)}</span><span class="facts__l">days travelling, across {m.trips} trips</span></li>
      <li><span class="mono facts__v">{n(m.trekMiles)}</span><span class="facts__l">miles trekked <em>that were logged</em></span></li>
      <li><span class="mono facts__v">{n(m.maxElevationFt)} ft</span><span class="facts__l">highest point reached{m.highestEntry && <> — <a href={m.highestEntry.href}>{m.highestEntry.title}</a></>}</span></li>
      <li><span class="mono facts__v">{n(m.photos)}</span><span class="facts__l">photographs published</span></li>
      {m.longestTrip && (
        <li><span class="mono facts__v">{m.longestTrip.days}</span><span class="facts__l">days — longest single trip, <a href={m.longestTrip.href}>{m.longestTrip.title}</a></span></li>
      )}
      {m.longestGap && (
        <li><span class="mono facts__v">{n(m.longestGap.days)}</span><span class="facts__l">days — longest gap between trips, {m.longestGap.from} to {m.longestGap.to}</span></li>
      )}
    </ul>
  </section>

  <section class="band" aria-label="The writing">
    <h2 class="mono band__head">The writing</h2>
    <ul class="facts">
      <li><span class="mono facts__v">{n(Math.round(m.words / Math.max(1, m.entries)))}</span><span class="facts__l">words in an average entry</span></li>
      {m.longestEntry && (
        <li><span class="mono facts__v">{n(m.longestEntry.words)}</span><span class="facts__l">words — longest, <a href={m.longestEntry.href}>{m.longestEntry.title}</a></span></li>
      )}
      {m.shortestEntry && (
        <li><span class="mono facts__v">{n(m.shortestEntry.words)}</span><span class="facts__l">words — shortest, <a href={m.shortestEntry.href}>{m.shortestEntry.title}</a></span></li>
      )}
      <li><span class="mono facts__v">{m.byAuthor.beth} / {m.byAuthor.andy}</span><span class="facts__l">entries by Beth / by Andy</span></li>
      {m.busiestMonth && (
        <li><span class="mono facts__v">{m.busiestMonth.month}</span><span class="facts__l">busiest month, {m.busiestMonth.entries} entries across all years</span></li>
      )}
      {m.mostEntries && (
        <li><span class="mono facts__v">{m.mostEntries.entries}</span><span class="facts__l">entries — most written on one trip, <a href={m.mostEntries.href}>{m.mostEntries.title}</a></span></li>
      )}
    </ul>
  </section>

  <section class="band" aria-label="Entries by year">
    <h2 class="mono band__head">Entries by year</h2>
    <ol class="years">
      {m.byYear.map((y) => (
        <li>
          <span class="mono years__y">{y.year}</span>
          <span class="years__bar" style={`--w:${(y.entries / maxYear) * 100}%`} aria-hidden="true"></span>
          <span class="mono years__n">{y.entries}</span>
        </li>
      ))}
    </ol>
    <p class="mono band__note">
      Entry counts follow publish dates, so a trip that straddles New Year lands
      in both.
    </p>
  </section>

  <section class="band" aria-label="Where">
    <h2 class="mono band__head">Where — {t.countries} countries, {t.continents.length} continents</h2>
    <div class="conts">
      {t.continents.map((c) => (
        <div class="cont">
          <h3 class="mono cont__head">{c.name} <span class="cont__n">{c.places.length}</span></h3>
          <ul>{c.places.map((p) => <li>{p.written ? <a href={placeHref(p.code)}>{p.name}</a> : p.name}</li>)}</ul>
        </div>
      ))}
    </div>
    <p class="mono band__note">Linked countries have entries; the rest are still waiting to be written up.</p>
  </section>

  <section class="band" aria-label="Still to be counted">
    <h2 class="mono band__head">Still to be counted</h2>
    <ul class="facts facts--muted">
      <li><span class="mono facts__v">{m.bethCried}</span><span class="facts__l">times Beth cried — <a href="/beth-cried-here/">the register</a> is built, the tagging is theirs</span></li>
      <li><span class="mono facts__v">{m.tagged} / {m.entries}</span><span class="facts__l">entries tagged by theme</span></li>
      <li><span class="mono facts__v">0</span><span class="facts__l">GPS coordinates — stripped from every archived photograph before we got to them</span></li>
    </ul>
  </section>

  {m.caveats.length > 0 && (
    <section class="band caveats" aria-label="What these numbers do and don't say">
      <h2 class="mono band__head">What these numbers don't say</h2>
      <ul>{m.caveats.map((c) => <li>{c}</li>)}</ul>
    </section>
  )}
</Base>

<style>
  .head {
    max-width: 60rem; margin: 0 auto;
    padding: clamp(2rem, 5vw, 3.5rem) clamp(1rem, 4vw, 3rem) 0;
  }
  .head h1 { font-size: clamp(2.4rem, 6vw, 3.75rem); margin: 0; }
  .head__note { color: var(--color-stone); margin: 0.7rem 0 0; max-width: 54ch; }

  .headline {
    margin: clamp(1.75rem, 4vw, 2.75rem) 0 0;
    padding: clamp(1.75rem, 4vw, 2.75rem) clamp(1rem, 4vw, 3rem);
    background: var(--color-ink);
    color: var(--color-snow);
  }
  .headline dl {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
    gap: 1.75rem 2rem;
    max-width: 60rem; margin: 0 auto;
  }
  .headline__v {
    margin: 0;
    font-size: clamp(1.9rem, 5vw, 3rem);
    line-height: 1;
    letter-spacing: -0.01em;
    color: var(--color-snow);
  }
  .headline__l {
    margin-top: 0.45rem;
    font-size: 0.625rem;
    color: var(--color-stone-on-dark);
  }

  .band {
    max-width: 60rem; margin: clamp(2.25rem, 5vw, 3.25rem) auto 0;
    padding-inline: clamp(1rem, 4vw, 3rem);
  }
  .band__head { color: var(--color-stone); margin: 0 0 1rem; }
  .band__sub { color: var(--color-stone); margin: 2rem 0 0.75rem; font-weight: 400; }
  .band__note { color: var(--color-stone); font-size: 0.625rem; margin-top: 0.9rem; }

  .facts { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--color-rule); }
  .facts li {
    display: grid;
    grid-template-columns: minmax(6.5rem, auto) 1fr;
    gap: 0.35rem 1.25rem;
    align-items: baseline;
    padding: 0.7rem 0;
    border-bottom: 1px solid var(--color-rule);
  }
  .facts__v { font-size: 1.25rem; color: var(--color-ink); letter-spacing: 0; }
  .facts__l { color: var(--color-stone); font-size: 1rem; }
  .facts__l em { font-style: italic; }
  .facts--muted .facts__v { color: var(--color-stone); }

  .years { list-style: none; margin: 0; padding: 0; }
  .years li {
    display: grid;
    grid-template-columns: 3rem 1fr 2.5rem;
    align-items: center;
    gap: 0.75rem;
    padding: 0.2rem 0;
  }
  .years__y { color: var(--color-stone); font-size: 0.6875rem; }
  .years__bar {
    height: 0.6rem;
    width: var(--w);
    min-width: 2px;
    background: var(--color-rime-on-light);
  }
  .years__n { color: var(--color-stone); font-size: 0.6875rem; text-align: right; }

  .conts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
    gap: 1.5rem;
  }
  .cont__head { color: var(--color-ink); margin: 0 0 0.5rem; }
  .cont__n { color: var(--color-ember); }
  .cont ul { list-style: none; margin: 0; padding: 0; }
  .cont li { color: var(--color-stone); padding: 0.15rem 0; font-size: 0.9375rem; }

  .cont li a { color: var(--color-ink); }

  /* The running total: a pale bar for what came before, the dark end for what
     the year added, a 2px gap between so the step reads. The pale tone is
     deliberately quiet (1.9:1); every row prints its total, so nothing rests on it. */
  .cum { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--color-rule); }
  .cum__row {
    display: grid;
    grid-template-columns: 4.5rem minmax(0, 1fr) 3.5rem;
    grid-template-areas: 'y bar n' '. names names';
    align-items: center;
    column-gap: 0.75rem;
    padding: 0.35rem 0;
    border-bottom: 1px solid var(--color-rule);
  }
  .cum__y { grid-area: y; color: var(--color-stone); font-size: 0.6875rem; }
  .cum__bar { grid-area: bar; display: flex; gap: 2px; height: 0.7rem; }
  .cum__old, .cum__new { display: block; flex: none; width: var(--w); height: 100%; }
  .cum__old { background: #9fbfc7; }
  .cum__new { background: var(--color-rime-on-light); min-width: 3px; border-radius: 0 2px 2px 0; }
  .cum__n { grid-area: n; text-align: right; font-size: 0.75rem; color: var(--color-ink); letter-spacing: 0; }
  .cum__plus { color: var(--color-rime-on-light); margin-right: 0.4rem; }
  .cum__names { grid-area: names; font-size: 0.875rem; color: var(--color-stone); padding-top: 0.15rem; }
  .cum__names a { color: var(--color-ink); }
  .cum__row--gap .cum__names { font-style: italic; }

  .stamps {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: 1rem;
  }
  .stamp {
    border: 1px solid var(--color-rule);
    border-top: 3px solid var(--color-ink);
    padding: 1rem 1.1rem 1.1rem;
  }
  .stamp__v { margin: 0; font-size: 2.25rem; line-height: 1; color: var(--color-ink); letter-spacing: -0.01em; }
  .stamp__l { margin: 0.35rem 0 0.7rem; color: var(--color-stone); }
  .stamp ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.2rem 0.9rem; }
  .stamp li { font-size: 0.9375rem; color: var(--color-stone); }
  .stamp li a { color: var(--color-ink); }

  .most li { grid-template-columns: 9rem minmax(0, 1fr) 2.5rem; grid-template-areas: 'name bar n' '. yrs yrs'; }
  .most__name { grid-area: name; font-size: 0.9375rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .most__name a { color: var(--color-ink); }
  .most .years__bar { grid-area: bar; }
  .most .years__n { grid-area: n; }
  .most__yrs { grid-area: yrs; color: var(--color-stone); font-size: 0.625rem; }

  .caveats ul { margin: 0; padding-left: 1.1rem; color: var(--color-stone); max-width: 62ch; }
  .caveats li { padding: 0.3rem 0; font-size: 0.9375rem; line-height: 1.5; }

  @media (max-width: 560px) {
    .facts li { grid-template-columns: 1fr; }
    .cum__row { grid-template-columns: 3.75rem minmax(0, 1fr) 3rem; }
    .most li { grid-template-columns: 6.5rem minmax(0, 1fr) 2rem; }
  }
</style>
