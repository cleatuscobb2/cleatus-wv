---
/**
 * The Instagram posts from a trip: each with all its photos in a strip you can
 * swipe, and the caption in full. Plain HTML; the videos only load when played.
 */
import { fmtDateShort } from '../lib/entries.ts';

interface Media { src: string; thumb: string; poster?: string; w: number; h: number; video?: boolean }
interface Post { id: string; data: { author: string; date: string; caption: string; place?: string; media: Media[] } }
interface Props { posts: Post[] }
const { posts } = Astro.props;
const when = (d: string) => {
  const date = new Date(`${d}T00:00:00Z`);
  return `${fmtDateShort(date)} ${date.getUTCFullYear()}`;
};
---
<section class="ig" aria-labelledby="ig-head">
  <h2 class="mono ig__head" id="ig-head">From Instagram <span class="ig__n">{posts.length}</span></h2>
  <div class="ig__grid">
    {posts.map((p) => (
      <article class="ig__post">
        <div class="ig__strip" tabindex={p.data.media.length > 1 ? 0 : undefined} aria-label={p.data.media.length > 1 ? `${p.data.media.length} photos, scroll sideways` : undefined}>
          {p.data.media.map((m) => m.video ? (
            <video src={m.src} poster={m.poster} controls preload="none" playsinline width={m.w} height={m.h}></video>
          ) : (
            <a href={m.src} aria-label="Enlarge photo"><img src={m.thumb} alt="" loading="lazy" decoding="async" width={m.w} height={m.h} /></a>
          ))}
        </div>
        {p.data.media.length > 1 && <p class="mono ig__more">{p.data.media.length} photos · swipe</p>}
        {p.data.caption && <p class="ig__caption">{p.data.caption}</p>}
        <p class="mono ig__meta">{[when(p.data.date), p.data.place, p.data.author].filter(Boolean).join(' · ')}</p>
      </article>
    ))}
  </div>
</section>

<script>
  import { openLightbox, plainClick } from '../scripts/lightbox.ts';

  // Enlarge in place; each post's photos step through together.
  document.querySelectorAll<HTMLElement>('.ig__post').forEach((post) => {
    const links = [...post.querySelectorAll<HTMLAnchorElement>('.ig__strip a')];
    const caption = post.querySelector('.ig__caption')?.textContent ?? '';
    const meta = post.querySelector('.ig__meta')?.textContent ?? '';
    links.forEach((a, i) => a.addEventListener('click', (e) => {
      if (!plainClick(e)) return;
      e.preventDefault();
      openLightbox(links.map((l) => ({ src: l.href, caption, meta })), i);
    }));
  });
</script>

<style>
  .ig { max-width: 76rem; margin: clamp(2.5rem, 6vw, 4rem) auto 0; padding: 0 clamp(1rem, 4vw, 3rem); }
  .ig__head { font-size: 0.8125rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--color-stone); margin: 0 0 1rem; }
  .ig__n { opacity: 0.75; margin-left: 0.3rem; }
  .ig__grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 16rem), 1fr)); gap: clamp(1rem, 2.5vw, 1.75rem); align-items: start; }
  .ig__post { min-width: 0; }
  .ig__strip { display: flex; overflow-x: auto; scroll-snap-type: x mandatory; aspect-ratio: 1; background: var(--color-rule); }
  .ig__strip > * { flex: 0 0 100%; width: 100%; height: 100%; scroll-snap-align: start; display: block; }
  .ig__strip img, .ig__strip video { width: 100%; height: 100%; object-fit: cover; display: block; }
  .ig__strip a { cursor: zoom-in; }
  .ig__more { margin: 0.35rem 0 0; font-size: 0.6875rem; color: var(--color-stone); }
  .ig__caption { margin: 0.55rem 0 0; font-size: 0.9375rem; line-height: 1.45; white-space: pre-line; overflow-wrap: anywhere; }
  .ig__meta { margin: 0.45rem 0 0; font-size: 0.6875rem; color: var(--color-stone); }
</style>
