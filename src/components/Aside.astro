---
/**
 * Glossary-style interruption (§7.3) — what a Balti crampon is, why the GG La
 * descent kills people — without breaking the run of the prose.
 */
interface Props {
  term: string;
}
const { term } = Astro.props;
---

<aside class="note">
  <p class="note__term mono">{term}</p>
  <div class="note__body"><slot /></div>
</aside>

<style>
  .note {
    max-width: var(--measure);
    margin-block: 2rem;
    padding: 1rem 1.15rem;
    background: var(--color-paper);
    border: 1px solid var(--color-rule);
    border-left: 3px solid var(--color-rime);
  }
  .note__term {
    margin: 0 0 0.4rem;
    color: var(--color-stone);
  }
  .note__body {
    font-size: 1.0625rem;
    line-height: 1.55;
  }
  .note__body :global(p) {
    margin: 0;
  }
  .note__body :global(p + p) {
    margin-top: 0.7em;
  }
</style>
