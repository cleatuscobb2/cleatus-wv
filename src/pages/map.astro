---
/**
 * §7.4 — not built yet. This is a deliberate placeholder rather than a broken
 * nav link: the map needs coordinates, and the archive has none (Squarespace and
 * Google both stripped GPS from every image). See PHASE-0-REPORT.md §3.
 */
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { COUNTRY_NAMES } from '../data/trip-meta.ts';

const trips = await getCollection('trips');
const countries = [...new Set(trips.flatMap((t) => t.data.countries))].sort();
---

<Base
  title="Map"
  description="Every trip Andy and Beth have taken, plotted — coming once the route data is in."
  noIndex={true}
>
  <div class="soon">
    <h1 class="display">Map</h1>
    <p class="soon__lede">
      Not built yet, and deliberately not faked. Plotting these trips needs
      coordinates, and there are none in the archive — the image EXIF was stripped
      by Squarespace and Google before we ever got to it.
    </p>
    <p class="soon__lede">
      It needs one of: GPS from the original photographs, GPX tracks, or a pass
      adding <code class="mono">location</code> coordinates to entries by hand.
    </p>

    <h2 class="mono soon__head">Where these {trips.length} trips went</h2>
    <ul class="soon__countries">
      {countries.map((c) => <li class="mono">{COUNTRY_NAMES[c] ?? c}</li>)}
    </ul>
  </div>
</Base>

<style>
  .soon {
    max-width: calc(var(--measure) + 4rem);
    margin: 0 auto;
    padding: clamp(2.5rem, 6vw, 4rem) clamp(1rem, 4vw, 3rem) 0;
  }
  .soon h1 {
    font-size: clamp(2.2rem, 5vw, 3.25rem);
    margin: 0 0 1.25rem;
  }
  .soon__lede {
    max-width: 56ch;
  }
  .soon__head {
    color: var(--color-stone);
    margin: 2.5rem 0 0.9rem;
  }
  .soon__countries {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .soon__countries li {
    padding: 0.3rem 0.6rem;
    border: 1px solid var(--color-rule);
    color: var(--color-stone);
  }
</style>
