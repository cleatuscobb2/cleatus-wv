---
/**
 * /admin/readers — who is reading, counted by the site itself (readers.ts).
 *
 * Behind the sign-in because the numbers are about other people. Read live on
 * each visit; nothing is baked in at deploy.
 */
import { getCollection } from 'astro:content';
import AdminLayout from '../AdminLayout.astro';
import { guard, userOf } from '../guard.ts';
import { HOSTED } from '../mode.ts';
import { ranked, readReport, TIME_ZONE } from '../readers.ts';

export const prerender = false;

const blocked = guard(Astro.request);
if (blocked) return blocked;
const user = HOSTED ? userOf(Astro.request) : null;

const RANGES = [7, 30, 90, 365];
const n = RANGES.includes(Number(Astro.url.searchParams.get('days'))) ? Number(Astro.url.searchParams.get('days')) : 30;

let report;
let failed = '';
try { report = await readReport(n); } catch (e) { failed = (e as Error).message; }

// What each path is, in words.
const entries = await getCollection('entries');
const trips = await getCollection('trips');
const titleOf = new Map<string, string>([
  ['/', 'Home'], ['/map/', 'Map'], ['/numbers/', 'By the numbers'], ['/archive/', 'Archive'], ['/about/', 'About'],
  ['/search/', 'Search'], ['/trips/', 'All trips'], ['/places/', 'Places'], ['/tags/', 'Tags'], ['/beth-cried-here/', 'Beth cried here'],
  ...trips.map((t) => [`/${t.id}/`, t.data.title] as [string, string]),
  ...entries.map((e) => [`/${e.data.trip.id}/${e.id.split('/').pop()}/`, e.data.title] as [string, string]),
]);
const tripOf = new Map(trips.map((t) => [t.id, t.data.shortTitle]));
const visited = new Set(trips.flatMap((t) => t.data.countries));
const regionName = new Intl.DisplayNames(['en'], { type: 'region' });
const countryName = (cc: string) => { try { return cc === 'XX' ? 'Unknown' : regionName.of(cc) ?? cc; } catch { return cc; } };

const fmt = new Intl.NumberFormat('en-US');
const dayLabel = (d: string, long = false) =>
  new Date(`${d}T12:00:00Z`).toLocaleDateString('en-GB', long ? { weekday: 'short', day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' } : { day: 'numeric', month: 'short', timeZone: 'UTC' });
function delta(now: number, before: number) {
  if (!before) return now ? 'new this period' : '';
  const pct = Math.round(((now - before) / before) * 100);
  return `${pct > 0 ? '▲' : pct < 0 ? '▼' : '='} ${Math.abs(pct)}% vs the ${n} days before`;
}

// ---- the daily chart --------------------------------------------------------
const days = report?.days ?? [];
const max = Math.max(1, ...days.map((d) => d.views));
// A clean top for the axis: 1, 2 or 5 × a power of ten.
const niceMax = (() => {
  const p = 10 ** Math.floor(Math.log10(max));
  return [1, 2, 5, 10].map((m) => m * p).find((v) => v >= max)!;
})();
// `* 0.5`, not `/ 2`: two slashes on one line here read as a regex to Astro's compiler.
const half = niceMax * 0.5;
const ticks = Number.isInteger(half) ? [0, half, niceMax] : [0, niceMax];
const labelEvery = Math.ceil(days.length / 6);
// A year of columns is 365 tab stops; past 90 days the keyboard route is the table.

const list = (m: Map<string, number> | undefined, limit = 12) => {
  const rows = m ? ranked(m, limit) : [];
  const top = Math.max(1, ...rows.map((r) => r[1]));
  return rows.map(([k, v]) => ({ key: k, value: v, pct: (v / top) * 100 }));
};
const pages = list(report?.pages, 15);
const countries = list(report?.countries, 15);
const referrers = list(report?.referrers, 10);
const kinds = [
  { title: 'Device', rows: list(report?.devices, 4) },
  { title: 'Browser', rows: list(report?.browsers, 6) },
  { title: 'System', rows: list(report?.systems, 6) },
];
const countryCount = report ? [...report.countries.keys()].filter((c) => c !== 'XX').length : 0;
---

<AdminLayout title="Readers" current="readers" user={user}>
  <h1 class="ad-h1">Readers</h1>
  <p class="ad-lede">
    Counted by the site itself — no cookies, no identifiers, and
    browsers that ask not to be tracked aren't counted. Days run midnight to midnight,
    California time.
  </p>

  <nav class="rd-range" aria-label="Period">
    {RANGES.map((r) => <a href={`?days=${r}`} class="mono" aria-current={r === n ? 'page' : undefined}>{r === 365 ? 'Year' : `${r} days`}</a>)}
  </nav>

  {failed ? (
    <p class="rd-empty">The numbers couldn't be read just now ({failed}). Try again in a minute.</p>
  ) : !report || !report.views ? (
    <p class="rd-empty">Nothing counted in this period yet. Counting started when this page went live; readers appear here as they arrive.</p>
  ) : (
    <>
      <div class="rd-tiles">
        <div class="rd-tile">
          <p class="rd-tile__label">Page views</p>
          <p class="rd-tile__value">{fmt.format(report.views)}</p>
          <p class="rd-tile__delta">{delta(report.views, report.prevViews)}</p>
        </div>
        <div class="rd-tile">
          <p class="rd-tile__label">Visitors <span class="rd-approx">(estimate)</span></p>
          <p class="rd-tile__value">{fmt.format(report.visitors)}</p>
          <p class="rd-tile__delta">{delta(report.visitors, report.prevVisitors)}</p>
        </div>
        <div class="rd-tile">
          <p class="rd-tile__label">Countries</p>
          <p class="rd-tile__value">{countryCount}</p>
          <p class="rd-tile__delta">{report.firstDay && report.firstDay !== days[0]?.day ? `counting since ${dayLabel(report.firstDay)}` : ''}</p>
        </div>
      </div>

      <section class="rd-card">
        <h2 class="rd-h">Page views per day</h2>
        <!-- HTML, not a scaled SVG: the axis text stays readable at any width. -->
        <div class="rd-chart" role="group" aria-label={`Page views per day, last ${n} days. Every value is also in the table below.`}>
          <div class="rd-plot">
            {ticks.map((t) => (
              <span class="rd-gridline" style={`bottom:${(t / niceMax) * 100}%`}><span class="rd-tick">{fmt.format(t)}</span></span>
            ))}
            <div class="rd-cols" style={`--n:${days.length}`}>
              {days.map((d) => (
                <span
                  class="rd-hit" tabindex={days.length <= 90 ? 0 : undefined} role="img"
                  data-tip={`${dayLabel(d.day, true)}|${fmt.format(d.views)} views|${fmt.format(d.visitors)} visitors`}
                  aria-label={`${dayLabel(d.day, true)}: ${d.views} views, ${d.visitors} visitors`}
                ><span class="rd-col" style={`height:${(d.views / niceMax) * 100}%`}></span></span>
              ))}
            </div>
          </div>
          <div class="rd-xlabels" aria-hidden="true" style={`--n:${days.length}`}>
            {days.map((d, i) => <span>{i % labelEvery === 0 || i === days.length - 1 ? dayLabel(d.day) : ''}</span>)}
          </div>
          <div class="rd-tip" id="rd-tip" role="status" hidden></div>
        </div>
        <details class="rd-table">
          <summary class="mono">Show as a table</summary>
          <table>
            <thead><tr><th scope="col">Day</th><th scope="col">Views</th><th scope="col">Visitors</th></tr></thead>
            <tbody>{[...days].reverse().map((d) => <tr><td>{dayLabel(d.day, true)}</td><td>{fmt.format(d.views)}</td><td>{fmt.format(d.visitors)}</td></tr>)}</tbody>
          </table>
        </details>
      </section>

      <div class="rd-grid2">
        <section class="rd-card">
          <h2 class="rd-h">Most read</h2>
          <ol class="rd-bars">
            {pages.map((r) => {
              const [, trip] = r.key.split('/');
              const isEntry = r.key.split('/').filter(Boolean).length === 2;
              return (
                <li>
                  <span class="rd-bars__label">
                    <a href={r.key} target="_blank" rel="noopener">{titleOf.get(r.key) ?? r.key}</a>
                    {isEntry && tripOf.get(trip) && <span class="rd-sub">{tripOf.get(trip)}</span>}
                  </span>
                  <span class="rd-bars__bar"><span style={`width:${r.pct}%`}></span></span>
                  <span class="rd-bars__n">{fmt.format(r.value)}</span>
                </li>
              );
            })}
          </ol>
        </section>

        <section class="rd-card">
          <h2 class="rd-h">Where they are</h2>
          <ol class="rd-bars">
            {countries.map((r) => (
              <li>
                <span class="rd-bars__label">{countryName(r.key)}{visited.has(r.key) && <span class="rd-sub">you've been</span>}</span>
                <span class="rd-bars__bar"><span style={`width:${r.pct}%`}></span></span>
                <span class="rd-bars__n">{fmt.format(r.value)}</span>
              </li>
            ))}
          </ol>
        </section>

        <section class="rd-card">
          <h2 class="rd-h">How they arrived</h2>
          <ol class="rd-bars">
            {referrers.map((r) => (
              <li>
                <span class="rd-bars__label">{r.key === '(direct)' ? 'Typed it in, a bookmark, or an app' : r.key}</span>
                <span class="rd-bars__bar"><span style={`width:${r.pct}%`}></span></span>
                <span class="rd-bars__n">{fmt.format(r.value)}</span>
              </li>
            ))}
          </ol>
        </section>

        <section class="rd-card">
          <h2 class="rd-h">What they read on</h2>
          {kinds.map((k) => (
            <>
              <h3 class="rd-h3 mono">{k.title}</h3>
              <ol class="rd-bars rd-bars--compact">
                {k.rows.map((r) => (
                  <li>
                    <span class="rd-bars__label">{r.key}</span>
                    <span class="rd-bars__bar"><span style={`width:${r.pct}%`}></span></span>
                    <span class="rd-bars__n">{fmt.format(r.value)}</span>
                  </li>
                ))}
              </ol>
            </>
          ))}
        </section>
      </div>
    </>
  )}

  <aside class="rd-note">
    <h2 class="rd-h">What this can't tell you</h2>
    <p>
      How often any one person comes back, or what one person read. That would need an
      identifier kept on each reader's device — and, for readers in Europe, a consent
      banner. Visitors are estimated a day at a time from a hash that changes daily, so
      the same person on two days counts twice in a range. That's the price of not
      tracking anyone.
    </p>
  </aside>
</AdminLayout>

<script>
  // One tooltip for every column: hover or keyboard focus shows the day's numbers.
  const tip = document.getElementById('rd-tip');
  const chart = tip?.parentElement;
  function show(el: Element) {
    if (!tip || !chart) return;
    const [day, views, visitors] = (el.getAttribute('data-tip') ?? '').split('|');
    tip.replaceChildren();
    const v = document.createElement('strong'); v.textContent = views;
    const u = document.createElement('span'); u.textContent = visitors;
    const d = document.createElement('span'); d.className = 'rd-tip__day'; d.textContent = day;
    tip.append(v, u, d);
    tip.hidden = false;
    const box = chart.getBoundingClientRect();
    const r = el.getBoundingClientRect();
    const x = Math.min(Math.max(r.left + r.width / 2 - box.left, 70), box.width - 70);
    tip.style.left = x + "px"; // no template literal: this script is inlined inside one
    document.querySelectorAll('.rd-hit.is-on').forEach((n) => n.classList.remove('is-on'));
    el.classList.add('is-on');
  }
  for (const el of document.querySelectorAll('.rd-hit')) {
    el.addEventListener('pointerenter', () => show(el));
    el.addEventListener('focus', () => show(el));
  }
  chart?.addEventListener('pointerleave', () => { if (tip) tip.hidden = true; });
</script>

<style>
  .rd-range { display: flex; gap: 0.4rem; margin-top: 1.25rem; flex-wrap: wrap; }
  .rd-range a {
    font-size: 0.6875rem; text-decoration: none; padding: 0.35rem 0.7rem;
    border: 1px solid var(--color-rule); color: var(--color-ink); background: var(--color-paper);
  }
  .rd-range a[aria-current='page'] { background: var(--color-ink); color: var(--color-snow); border-color: var(--color-ink); }
  .rd-empty { margin-top: 1.5rem; padding: 1rem 1.2rem; background: var(--color-paper); border: 1px solid var(--color-rule); max-width: 52rem; }

  .rd-tiles { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(13rem, 100%), 1fr)); gap: 0.75rem; margin-top: 1.25rem; max-width: 64rem; }
  .rd-tile { background: var(--color-paper); border: 1px solid var(--color-rule); padding: 0.9rem 1rem; }
  .rd-tile p { margin: 0; }
  .rd-tile__label { font-size: 0.875rem; color: var(--color-stone); }
  .rd-approx { font-size: 0.75rem; }
  .rd-tile__value { font-family: var(--font-display); font-weight: 600; font-size: 2.25rem; line-height: 1.15; margin-top: 0.15rem !important; }
  .rd-tile__delta { font-family: var(--font-mono); font-size: 0.6875rem; color: var(--color-stone); min-height: 1em; }

  .rd-card { background: var(--color-paper); border: 1px solid var(--color-rule); padding: 1rem 1.1rem; margin-top: 1rem; max-width: 64rem; }
  .rd-h { font-family: var(--font-display); font-size: 1.05rem; margin: 0 0 0.75rem; }
  .rd-h3 { font-size: 0.625rem; color: var(--color-stone); margin: 0.9rem 0 0.35rem; font-weight: 500; }
  .rd-chart { position: relative; padding-left: 2.75rem; }
  .rd-plot { position: relative; height: 180px; }
  .rd-gridline { position: absolute; left: 0; right: 0; height: 0; border-top: 1px solid var(--color-rule); }
  .rd-tick {
    position: absolute; right: calc(100% + 0.5rem); top: -0.45rem;
    font-family: var(--font-mono); font-size: 0.6875rem; color: var(--color-stone); white-space: nowrap;
  }
  .rd-cols { position: absolute; inset: 0; display: grid; grid-template-columns: repeat(var(--n), minmax(0, 1fr)); align-items: end; }
  /* Each day's slot is the hit target; the column inside is the mark. */
  .rd-hit { height: 100%; display: flex; align-items: flex-end; justify-content: center; outline: none; }
  .rd-col {
    display: block; width: min(24px, calc(100% - 2px)); min-width: 1px;
    background: #00829c; border-radius: 4px 4px 0 0;
  }
  .rd-hit.is-on, .rd-hit:focus-visible { background: color-mix(in srgb, var(--color-ink) 6%, transparent); }
  .rd-hit:focus-visible { box-shadow: inset 0 0 0 2px var(--color-rime-on-light); }
  .rd-xlabels { display: grid; grid-template-columns: repeat(var(--n, 1), minmax(0, 1fr)); margin-top: 0.35rem; }
  .rd-xlabels span { font-family: var(--font-mono); font-size: 0.625rem; color: var(--color-stone); white-space: nowrap; overflow: visible; }
  .rd-tip {
    position: absolute; top: -0.4rem; transform: translate(-50%, -100%); pointer-events: none;
    background: var(--color-ink); color: var(--color-snow); padding: 0.4rem 0.6rem; font-size: 0.8125rem;
    display: grid; gap: 0.05rem; white-space: nowrap; box-shadow: 0 4px 12px rgb(18 22 28 / 0.2);
  }
  .rd-tip[hidden] { display: none; }
  .rd-tip :global(strong) { font-size: 0.9375rem; }
  .rd-tip :global(.rd-tip__day) { font-family: var(--font-mono); font-size: 0.6875rem; color: var(--color-stone-on-dark); }
  .rd-table { margin-top: 0.6rem; }
  .rd-table summary { font-size: 0.6875rem; cursor: pointer; color: var(--color-rime-on-light); }
  .rd-table table { margin-top: 0.5rem; border-collapse: collapse; font-size: 0.875rem; }
  .rd-table th, .rd-table td { text-align: right; padding: 0.2rem 0.8rem; border-bottom: 1px solid var(--color-rule); }
  .rd-table th:first-child, .rd-table td:first-child { text-align: left; padding-left: 0; }

  .rd-grid2 { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(22rem, 100%), 1fr)); gap: 0 1rem; max-width: 64rem; }
  .rd-bars { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.45rem; }
  .rd-bars li { display: grid; grid-template-columns: minmax(0, 1.4fr) minmax(3rem, 1fr) 3.2rem; gap: 0.6rem; align-items: center; font-size: 0.875rem; }
  .rd-bars__label { min-width: 0; overflow-wrap: anywhere; }
  .rd-bars__label a { text-decoration: none; }
  .rd-bars__label a:hover { text-decoration: underline; }
  .rd-sub { display: block; font-family: var(--font-mono); font-size: 0.625rem; color: var(--color-stone); }
  .rd-bars__bar { display: block; height: 8px; }
  .rd-bars__bar span { display: block; height: 100%; min-width: 2px; background: #00829c; border-radius: 0 4px 4px 0; }
  .rd-bars__n { font-family: var(--font-mono); font-size: 0.75rem; text-align: right; }
  .rd-bars--compact li { font-size: 0.8125rem; }

  .rd-note { margin-top: 1.5rem; max-width: 52rem; padding: 1rem 1.2rem; border-left: 3px solid var(--color-rime-on-light); background: var(--color-paper); }
  .rd-note p { margin: 0; color: var(--color-stone); }
</style>
