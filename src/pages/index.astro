---
/**
 * The front door. The mosaic and the introduction open it; under them the page
 * leads on: the trip that is coming, the trip to start with (and its line, to
 * pick a day from), every trip in a row to run a thumb along, the map, and the
 * themes that cut across all of it. Everything is there without JavaScript; the
 * script at the bottom makes the clock tick and the pictures turn.
 */
import { getCollection } from 'astro:content';
import { Picture, getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import RouteLine from '../components/RouteLine.astro';
import mosaic from '../assets/home-mosaic.png';
import mosaicOg from '../assets/home-og.png';
import { fmtRange, chronological, tripIdOf, entrySlug, routeNodes } from '../lib/entries.ts';
import { firstPhoto } from '../lib/journey.ts';
import { cover } from '../lib/covers.ts';
import { travelMetrics } from '../lib/travel.ts';
import { beenTo } from '../data/been-to.ts';
import { COUNTRY_NAMES } from '../data/trip-meta.ts';
import { TAGS, TAG_ICONS, TAG_LABELS, BETH_CRIED_ICON } from '../data/tags.ts';

const now = new Date();
const DAY = 86_400_000;
const trips = (await getCollection('trips')).sort((a, b) => +b.data.dateStart - +a.data.dateStart);
const entries = chronological(await getCollection('entries', (e) => !e.data.draft));
const entriesOf = (id: string) => entries.filter((e) => tripIdOf(e) === id);
const nameOf = (code: string) => COUNTRY_NAMES[code] ?? code;
const fmtN = (n: number) => n.toLocaleString('en-US');

// A trip started in the admin ahead of time isn't one they've taken yet.
const taken = trips.filter((t) => +t.data.dateStart <= +now);
const featured = taken.find((t) => t.data.featured) ?? taken[0];
/** The soonest trip that isn't over: the one to count down to, or the one they're on. */
const next = [...trips].reverse().find((t) => +t.data.dateEnd + DAY >= +now && t.id !== featured?.id);
const nextAway = next ? +next.data.dateStart <= +now : false;

const featuredEntries = featured ? entriesOf(featured.id) : [];
const start = featured?.data.startHere
  ? featuredEntries.find((e) => entrySlug(e) === featured.data.startHere)
  : featuredEntries[0];
/** Up to eight pictures spread across the trip, starting with its cover. */
const featuredPhotos = (() => {
  if (!featured) return [];
  const all = [...new Set([featured.data.hero, ...featuredEntries.map(firstPhoto)].filter((p): p is string => Boolean(p)))];
  const spread = all.length <= 8 ? all : Array.from({ length: 8 }, (_, i) => all[Math.round((i * (all.length - 1)) / 7)]);
  return spread.map((p, i) => cover(p, i === 0 ? 'lg' : 'sm'));
})();
const nodes = routeNodes(featuredEntries);

const totalEntries = entries.filter((e) => trips.some((t) => t.id === tripIdOf(e))).length;

// The row of every trip, newest first.
const film = trips.map((t) => ({
  t,
  photo: t.data.hero ? cover(t.data.hero) : null,
  status: +now < +t.data.dateStart ? 'upcoming' : +now <= +t.data.dateEnd + DAY ? 'away' : 'done',
  daysUntil: Math.ceil((+t.data.dateStart - +now) / DAY),
}));

// The map: how far it reaches, and a reel of what is pinned to it.
const travel = travelMetrics(taken.map((t) => t.data), beenTo(now), now);
const pinned = (await getCollection('instagram'))
  .filter((p) => p.data.lat != null && p.data.lng != null)
  .sort((a, b) => a.data.date.localeCompare(b.data.date));
const reel = (() => {
  // One picture a place, then an even spread across the years.
  const seen = new Set<string>();
  const one = pinned.filter((p) => {
    const key = p.data.place ?? p.id;
    if (seen.has(key)) return false;
    seen.add(key);
    return true;
  });
  const want = Math.min(24, one.length);
  return Array.from({ length: want }, (_, i) => one[Math.round((i * (one.length - 1)) / Math.max(1, want - 1))]).map((p) => ({
    src: cover(p.data.media[0].thumb),
    label: [p.data.place, p.data.date.slice(0, 4)].filter(Boolean).join(', '),
  }));
})();

// The themes with the most written under them.
const themes = TAGS.map((tag) => ({ tag, n: entries.filter((e) => e.data.tags.includes(tag)).length }))
  .filter((x) => x.n > 0)
  .sort((a, b) => b.n - a.n)
  .slice(0, 8);
const cried = entries.filter((e) => e.data.bethCried).length;

/*
 * §7.8 — the mosaic makes a far better share card than the generated one: it is
 * the whole enterprise in a single picture.
 *
 * The share card uses the 16:9 version, not the banner. OG cards are ~1.91:1;
 * the banner is 3.59:1, so fitting it to a card either letterboxes it into a
 * thin strip or crops half the panels away. Same artwork, right shape for the
 * job.
 */
const ogMosaic = await getImage({ src: mosaicOg, width: 1200, height: 630, format: 'jpeg', quality: 82 });

/*
 * The tagline is voice, and voice is theirs — so it lives here as one obvious
 * line to change rather than buried in the markup.
 * Alternatives kept to hand: "Somewhere difficult, since 2009" ·
 * "Fifteen years of doing it the hard way" · "60 countries. 295 entries.
 * One of us cries." · "The long way round, every time"
 */
const TAGLINE = 'The Adventures of Cleatus & the West Virginian';
---


<Base
  title="Cleatus and the West Virginian"
  description={`Andy and Beth have been taking long, hard trips since 2009 — ${taken.length} of them, ${totalEntries} entries, from the Karakoram to Patagonia. Written mostly by Beth, mostly while exhausted.`}
  ogImage={ogMosaic.src}
>
  {/*
    The mosaic opens the site. Deliberately not a full-viewport hero with the
    title floated over it (§6.4) — it sits in its own dark band, complete and
    uncropped, with the words below it. It is a panelled illustration; cropping
    it to fit a viewport would cut panels off, which is the one thing it cannot
    survive.
  */}
  <div class="mosaic">
    <Picture
      src={mosaic}
      formats={['webp']}
      fallbackFormat="jpeg"
      quality={72}
      widths={[640, 960, 1280, 1600, 2048, 2560]}
      sizes="(max-width: 78rem) 100vw, 78rem"
      {/* AVIF is deliberately absent: measured on this image it runs ~15% larger
          than WebP at every size (910 KB vs 779 KB at 2048w), and <picture>
          serves the first supported source, so offering it would hand the
          heavier file to the browsers best able to avoid it. */}
      loading="eager"
      fetchpriority="high"
      decoding="sync"
      alt="An illustrated mosaic of Andy and Beth across fifteen years of trips: hiking a forest trail with packs, scuba diving over a reef, snowboarding, ice climbing roped together, on safari beside a lion, driving a speedboat, dressed up over dinner and champagne, reading a map in front of a city skyline, and mountain biking past a sign reading Biking Death Road."
    />
  </div>

  <section class="lede">
    {/* Wraps naturally rather than on a hard-coded <br>: the line that reads
        well at one length breaks badly at another, and this is a line Andy and
        Beth should be able to change without re-choosing where it folds. */}
    <h1 class="display lede__title">{TAGLINE}</h1>
    <p class="lede__body">
      Andy and Beth met on a study-abroad trip to Bangalore and have been going
      somewhere difficult ever since. {taken.length} trips, {totalEntries} entries,
      written mostly by Beth — usually the same night, usually exhausted.
    </p>
    <p class="mono lede__links">
      <a href="/trips/">All trips</a> · <a href="/map/">The map</a> · <a href="/archive/">Archive</a>
      {/* Shown by the script, which is what makes it work. */}
      <span data-dice-wrap> · <button type="button" class="lede__dice" data-dice hidden>🎲 A day at random</button></span>
    </p>
  </section>

  {next && (
    <a
      class="next"
      href={`/${next.id}/`}
      data-next
      data-start={+next.data.dateStart}
      data-end={+next.data.dateEnd}
    >
      <span class="next__in">
        <span class="next__words">
          <span class="mono next__kicker" data-next-kicker>{nextAway ? 'On the road now' : 'Up next'}</span>
          <span class="display next__title">{next.data.title}</span>
          <span class="mono next__where">
            {next.data.countries.map(nameOf).join(' · ')} · {fmtRange(next.data.dateStart, next.data.dateEnd)}
          </span>
        </span>
        {/* Days only until the script takes over; it adds the hours, minutes and seconds. */}
        <span class="next__clock mono" data-next-clock>
          {nextAway ? (
            <span class="next__cell"><b class="display">{Math.floor((+now - +next.data.dateStart) / DAY) + 1}</b> day of {next.data.stats.days}</span>
          ) : (
            <span class="next__cell"><b class="display">{Math.ceil((+next.data.dateStart - +now) / DAY)}</b> days</span>
          )}
        </span>
        <span class="next__go mono" aria-hidden="true">→</span>
      </span>
    </a>
  )}

  {featured && (
    <section class="feat" aria-labelledby="feat-title">
      <div class="feat__grid">
        <a
          href={`/${featured.id}/`}
          class="feat__media"
          data-turn={featuredPhotos.length > 1 ? JSON.stringify(featuredPhotos) : undefined}
          tabindex="-1"
          aria-hidden="true"
        >
          {featuredPhotos.length > 0 && (
            <>
              <img class="is-on" src={featuredPhotos[0]} alt="" loading="eager" decoding="async" />
              <img alt="" decoding="async" />
              {featuredPhotos.length > 1 && (
                <span class="feat__ticks">
                  {featuredPhotos.map((_, k) => <span class:list={['feat__tick', { on: k === 0 }]} />)}
                </span>
              )}
            </>
          )}
        </a>
        <div class="feat__words">
          <p class="mono feat__meta">
            {featured.id === taken[0]?.id ? 'Most recent' : 'Start with this one'} · {fmtRange(featured.data.dateStart, featured.data.dateEnd)}
          </p>
          <h2 class="display feat__title" id="feat-title">
            <a href={`/${featured.id}/`}>{featured.data.title}</a>
          </h2>
          <p class="feat__sum">{featured.data.summary}</p>
          <p class="mono feat__facts">
            {[
              `${featuredEntries.length} entries`,
              `${featured.data.stats.days} days`,
              featured.data.stats.trekMiles ? `${featured.data.stats.trekMiles} mi on foot` : null,
              featured.data.stats.maxElevationFt ? `${fmtN(featured.data.stats.maxElevationFt)} ft` : null,
            ].filter(Boolean).join(' · ')}
          </p>
          <p class="feat__go">
            {start && (
              <a href={`/${featured.id}/${entrySlug(start)}/`} class="btn btn--main mono">
                <span>Start here</span><span class="btn__more">— {start.data.title}</span>
              </a>
            )}
            <a href={`/${featured.id}/`} class="btn mono">The whole trip <span aria-hidden="true">→</span></a>
          </p>
        </div>
      </div>
      {nodes.length > 1 && (
        <div class="feat__line" data-line>
          <RouteLine nodes={nodes} tripSlug={featured.id} />
          <p class="mono feat__readout" data-readout aria-live="polite">
            {featured.data.stats.maxElevationFt ? 'Every dot is a day, at the height it was walked' : 'Every dot is an entry, spaced by date'} — pick one
          </p>
        </div>
      )}
    </section>
  )}

  <section class="film" data-film aria-labelledby="film-title">
    <header class="film__head">
      <h2 class="mono film__title" id="film-title">Every trip</h2>
      <span class="film__ctl" data-film-ctl hidden>
        <button type="button" class="ctl" data-film-prev aria-label="Scroll back"><span aria-hidden="true">←</span></button>
        <button type="button" class="ctl" data-film-next aria-label="Scroll on"><span aria-hidden="true">→</span></button>
      </span>
      <a href="/trips/" class="mono film__all">All {trips.length} on one page →</a>
    </header>
    <ol class="film__row" data-film-row>
      {film.map(({ t, photo, status, daysUntil }) => (
        <li class="film__item">
          <a href={`/${t.id}/`} class="film__link">
            <span class="film__pic">
              {photo ? (
                <img src={photo} alt="" loading="lazy" decoding="async" />
              ) : status === 'done' ? (
                <span class="film__none">
                  <span class="display">{t.data.countries.map(nameOf).join(' · ')}</span>
                  <span class="mono">No photographs</span>
                </span>
              ) : (
                <span class="film__soon">
                  <span class="mono film__soon-kicker">{status === 'away' ? 'On the road' : 'Up next'}</span>
                  <span class="display film__soon-big">{status === 'away' ? 'Away now' : `In ${daysUntil} days`}</span>
                </span>
              )}
            </span>
            <span class="mono film__when">{t.data.dateStart.getUTCFullYear()} · {t.data.stats.days} days</span>
            <span class="display film__name">{t.data.shortTitle}</span>
          </a>
        </li>
      ))}
    </ol>
  </section>

  <section class="globe" aria-labelledby="globe-title">
    <div class="globe__in">
      <div class="globe__words">
        <h2 class="display globe__title" id="globe-title">Everywhere we've been</h2>
        <p class="mono globe__facts">
          {travel.countries} countries · {travel.continents.length} continents{pinned.length > 0 && ` · ${pinned.length} photographs pinned to the map`}
        </p>
      </div>
      <a href="/map/" class="btn btn--main mono globe__go">Spin the globe <span aria-hidden="true">→</span></a>
    </div>
    {/* One link for the whole reel, for the pointer only: the button above is the way in for
        everyone else, and two dozen identical stops would be no kindness to a keyboard. */}
    {reel.length > 0 && (
      <a class="reel" href="/map/" tabindex="-1" aria-hidden="true">
        {/* The row is there twice so it can loop without a seam. */}
        <span class="reel__row">
          {[0, 1].map((pass) => reel.map((r) => (
            <span class:list={['reel__pic', { 'reel__pic--again': pass === 1 }]} title={r.label}>
              <img src={r.src} alt="" loading="lazy" decoding="async" width="240" height="300" />
            </span>
          )))}
        </span>
      </a>
    )}
  </section>

  {themes.length > 0 && (
    <section class="themes" aria-labelledby="themes-title">
      <h2 class="mono themes__title" id="themes-title">Or read by what happened</h2>
      <ul class="themes__list">
        {themes.map(({ tag, n }) => (
          <li>
            <a href={`/tags/${tag}/`} class="theme">
              <span class="theme__icon" aria-hidden="true">{TAG_ICONS[tag]}</span>
              <span class="theme__label">{TAG_LABELS[tag]}</span>
              <span class="mono theme__n">{n}</span>
            </a>
          </li>
        ))}
        {cried > 0 && (
          <li>
            <a href="/beth-cried-here/" class="theme">
              <span class="theme__icon" aria-hidden="true">{BETH_CRIED_ICON}</span>
              <span class="theme__label">Beth cried here</span>
              <span class="mono theme__n">{cried}</span>
            </a>
          </li>
        )}
      </ul>
      <p class="mono themes__more">
        <a href="/tags/">Every theme</a> · <a href="/numbers/">By the numbers</a> · <a href="/archive/">The whole archive</a>
      </p>
    </section>
  )}
</Base>

<script>
  const calm = matchMedia('(prefers-reduced-motion: reduce)');
  const fine = matchMedia('(hover: hover) and (pointer: fine)');

  // ---- the trip that is coming: a clock to the day they leave ----
  const next = document.querySelector<HTMLElement>('[data-next]');
  if (next) {
    const clock = next.querySelector<HTMLElement>('[data-next-clock]')!;
    const kicker = next.querySelector<HTMLElement>('[data-next-kicker]')!;
    // Astro scopes this page's styles to what it rendered; the cells made here carry the same mark.
    const scope = [...clock.attributes].find((a) => a.name.startsWith('data-astro-cid-'))?.name;
    const s = new Date(Number(next.dataset.start));
    const e = new Date(Number(next.dataset.end));
    // The dates are calendar days, so the clock runs to midnight where the reader is.
    const leaves = +new Date(s.getUTCFullYear(), s.getUTCMonth(), s.getUTCDate());
    const back = +new Date(e.getUTCFullYear(), e.getUTCMonth(), e.getUTCDate() + 1);
    const days = Math.round((back - leaves) / 86_400_000);
    const cell = (n: number | string, unit: string) => {
      const el = document.createElement('span');
      el.className = 'next__cell';
      const b = document.createElement('b');
      b.className = 'display';
      b.textContent = String(n);
      if (scope) { el.setAttribute(scope, ''); b.setAttribute(scope, ''); }
      el.append(b, ` ${unit}`);
      return el;
    };
    const two = (n: number) => String(n).padStart(2, '0');
    let timer = 0;
    const draw = () => {
      const left = leaves - Date.now();
      if (left > 0) {
        const sec = Math.floor(left / 1000);
        clock.replaceChildren(
          cell(Math.floor(sec / 86400), 'days'),
          cell(two(Math.floor(sec / 3600) % 24), 'hrs'),
          cell(two(Math.floor(sec / 60) % 60), 'min'),
          cell(two(sec % 60), 'sec'),
        );
      } else if (Date.now() < back) {
        kicker.textContent = 'On the road now';
        clock.replaceChildren(cell(Math.floor(-left / 86_400_000) + 1, `day of ${days}`));
      } else {
        // The page was built before they got home; there's nothing left to count.
        next.hidden = true;
        clearInterval(timer);
      }
    };
    draw();
    timer = window.setInterval(draw, 1000);
  }

  // ---- the featured trip's pictures turn over; move across them to flip through ----
  const media = document.querySelector<HTMLElement>('[data-turn]');
  if (media) {
    const photos: string[] = JSON.parse(media.dataset.turn!);
    const imgs = [...media.querySelectorAll('img')];
    const ticks = [...media.querySelectorAll('.feat__tick')];
    let front = 0;
    let shown = 0;
    let asked = 0;
    const show = (k: number) => {
      if (k === shown) return;
      const id = ++asked;
      const back = imgs[1 - front];
      const land = () => {
        if (id !== asked) return;
        imgs[front].classList.remove('is-on');
        back.classList.add('is-on');
        front = 1 - front;
        shown = k;
        ticks.forEach((t, j) => t.classList.toggle('on', j === k));
      };
      back.src = photos[k];
      back.decode().then(land, land);
    };
    let timer = 0;
    const play = () => {
      clearInterval(timer);
      if (calm.matches) return;
      timer = window.setInterval(() => { if (!document.hidden) show((shown + 1) % photos.length); }, 4500);
    };
    media.addEventListener('pointermove', (ev) => {
      if (!fine.matches) return;
      clearInterval(timer);
      const r = media.getBoundingClientRect();
      show(Math.min(photos.length - 1, Math.max(0, Math.floor(((ev.clientX - r.left) / r.width) * photos.length))));
    });
    media.addEventListener('pointerleave', play);
    play();
  }

  // ---- the line says which day is under the pointer ----
  const line = document.querySelector<HTMLElement>('[data-line]');
  const readout = line?.querySelector<HTMLElement>('[data-readout]');
  if (line && readout) {
    const idle = readout.textContent ?? '';
    line.querySelectorAll<SVGAElement>('.rl-node-link').forEach((a) => {
      const say = () => { readout.textContent = a.querySelector('title')?.textContent ?? idle; readout.classList.add('is-live'); };
      const hush = () => { readout.textContent = idle; readout.classList.remove('is-live'); };
      a.addEventListener('pointerenter', say);
      a.addEventListener('focus', say);
      a.addEventListener('pointerleave', hush);
      a.addEventListener('blur', hush);
    });
  }

  // ---- the row of trips: arrows for anyone without a trackpad ----
  const film = document.querySelector<HTMLElement>('[data-film]');
  if (film) {
    const row = film.querySelector<HTMLElement>('[data-film-row]')!;
    const ctl = film.querySelector<HTMLElement>('[data-film-ctl]')!;
    const prev = film.querySelector<HTMLButtonElement>('[data-film-prev]')!;
    const nextBtn = film.querySelector<HTMLButtonElement>('[data-film-next]')!;
    const by = (dir: number) => row.scrollBy({ left: dir * row.clientWidth * 0.8, behavior: calm.matches ? 'auto' : 'smooth' });
    const ends = () => {
      prev.disabled = row.scrollLeft < 4;
      nextBtn.disabled = row.scrollLeft + row.clientWidth > row.scrollWidth - 4;
      ctl.hidden = row.scrollWidth <= row.clientWidth + 4;
    };
    prev.addEventListener('click', () => by(-1));
    nextBtn.addEventListener('click', () => by(1));
    row.addEventListener('scroll', ends, { passive: true });
    addEventListener('resize', ends);
    ends();
  }

  // ---- somewhere at random ----
  const dice = document.querySelector<HTMLButtonElement>('[data-dice]');
  if (dice) {
    type Picks = { trips: [string, string][]; picks: [number, string, string, string, string | null][] };
    let picks: Promise<Picks> | null = null;
    const load = () => (picks ??= fetch('/picks.json').then((r) => r.json()));
    dice.hidden = false;
    dice.addEventListener('pointerenter', load, { once: true });
    dice.addEventListener('focus', load, { once: true });
    dice.addEventListener('click', async () => {
      try {
        const data = await load();
        // A day with a photograph, so it lands somewhere worth looking at.
        const withPhoto = data.picks.filter((p) => p[4]);
        const pool = withPhoto.length ? withPhoto : data.picks;
        const [trip, slug] = pool[Math.floor(Math.random() * pool.length)];
        location.href = `/${data.trips[trip][0]}/${slug}/`;
      } catch {
        location.href = '/archive/';
      }
    });
  }
</script>

<style>
  /* The mosaic's own stone-tile border is its frame; the dark band gives that
     frame somewhere to sit rather than butting it against the page edge. */
  .mosaic {
    background: var(--color-ink);
    /* A little room at the foot for the intro panel to sit into — kept smaller
       than the panel's negative margin, or the panel lands below the image
       instead of across it. */
    padding: clamp(0.75rem, 2.5vw, 2rem) clamp(0.5rem, 2vw, 2rem) clamp(0.75rem, 2vw, 1.5rem);
  }
  .mosaic :global(picture),
  .mosaic :global(img) {
    display: block;
    width: 100%;
    height: auto;
    max-width: 78rem;
    margin-inline: auto;
  }

  /*
   * The intro straddles the banner rather than floating on top of it.
   *
   * Text laid directly over this mosaic would be unreadable — it is dense
   * edge-to-edge illustration with no quiet corner that stays quiet across
   * breakpoints. So the intro is a pale panel pulled up over the lower edge of
   * the image: it genuinely overlaps the banner, but carries its own ground, so
   * both the words and the artwork stay legible. The overlap eases off on narrow
   * screens, where there is less image to spare.
   */
  .lede {
    position: relative;
    z-index: 2;
    max-width: 62rem;
    /* Deep enough that the heading itself lands on the artwork, not just the
       panel's padding — at the previous value the overlap was entirely consumed
       by padding-top and no text ever met the banner. */
    margin: clamp(-11rem, -11vw, -3rem) auto 0;
    padding: clamp(1.75rem, 4vw, 3rem) clamp(1.25rem, 4vw, 3rem) clamp(1.25rem, 3vw, 2rem);
  }
  /*
   * The glow follows the letters, not a block.
   *
   * There is no backing plate at all now — no gradient, no box. Legibility comes
   * entirely from a halo built into the glyphs: the radii are stacked tightly so
   * the first few build to near-solid white within two or three pixels of every
   * stroke, then taper. The result hugs the shapes of the words instead of
   * describing an invisible rectangle over the artwork.
   */
  .lede__title {
    font-size: clamp(1.9rem, 5vw, 3.5rem);
    margin: 0;
    text-align: center;
    text-wrap: balance;
    text-shadow:
      0 0 1px #fff, 0 0 2px #fff, 0 0 3px #fff, 0 0 4px #fff,
      0 0 6px #fff, 0 0 9px #fff, 0 0 14px #fff, 0 0 22px #fff;
  }
  .lede__body {
