---
/**
 * The who-we-are page, rendered from the archived original rather than rewritten.
 * Their words, not mine.
 */
import Base from '../layouts/Base.astro';
import { convert } from '../../scripts/html-to-mdx.ts';
// Imported, not read from disk: a path relative to this file breaks once the
// adapter prerenders from dist/server/.
import rawJson from '../../raw/pages/who-we-are.json';

const raw = rawJson as any;
const item = raw.item ?? raw.mainContent ?? raw.collection ?? {};
const html: string = item.body ?? raw.item?.body ?? '';
const { mdx } = convert(html);

// The converter emits markdown; for this one static page a paragraph split is enough.
const paras = mdx.split('\n\n').filter(Boolean);
---

<Base
  title="About"
  description="Andy from Fremont, California and Beth from South Charleston, West Virginia. They met in 2009 on an MBA trip to Bangalore and have been taking long, hard trips ever since."
>
  <article class="about">
    <h1 class="display">Who we are</h1>
    {paras.length > 0 ? (
      <div class="prose-entry">
        {paras.map((p) => <p>{p.replace(/\\([{}<])/g, '$1').replace(/[*_]/g, '')}</p>)}
      </div>
    ) : (
      <div class="prose-entry">
        <p>
          Andy — byline <strong>cleatus cobb</strong> — is from Fremont, California.
          Beth is from South Charleston, West Virginia. They met in 2009 on an MBA
          study-abroad trip to Bangalore and have been taking long, hard trips ever since.
        </p>
        <p>
          It's not a trip for the books unless Beth cries — hopefully only once.
        </p>
      </div>
    )}
    <p class="mono about__foot">
      <a href="/beth-cried-here/">Beth cried here →</a>
    </p>
    <section class="about__counting" aria-labelledby="counting">
      <h2 id="counting">What this site counts</h2>
      <p>
        So we can see what people read, the site keeps anonymous totals: pages viewed, roughly
        which city and country views come from, where they arrived from, reading time, how far
        down a page people get, what gets clicked and how fast pages load. Your browser also keeps
        a small note of when it last visited, so we can count returning visits as a total. Nothing
        identifies you or links one visit to another, and there's no advertising. Your network
        address is used only briefly, to keep out abuse, and isn't kept with any of this. Our
        host, Vercel, also runs its own anonymous page counts. If your browser asks sites not to
        track you, the site's own counting is skipped.
      </p>
    </section>
  </article>
</Base>

<style>
  .about {
    max-width: calc(var(--measure) + 6rem);
    margin: 0 auto;
    padding: clamp(2rem, 5vw, 3.5rem) clamp(1rem, 4vw, 3rem) 0;
  }
  .about h1 {
    font-size: clamp(2.2rem, 5vw, 3.25rem);
    margin: 0 0 1.5rem;
  }
  .about__foot {
    margin-top: 2.5rem;
    color: var(--color-stone);
  }
  .about__counting {
    margin-top: 2.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-rule);
    color: var(--color-stone);
    font-size: 0.9375rem;
    max-width: var(--measure);
  }
  .about__counting h2 {
    font-size: 1rem;
    margin: 0 0 0.4rem;
    color: var(--color-ink);
  }
  .about__counting p { margin: 0; }
</style>
