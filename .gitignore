node_modules/
dist/
.astro/
.vercel/
.env
.env.*
!.env.example
.DS_Store
Thumbs.db

# raw/ and assets/photos/ are deliberately NOT ignored.
# They are the archive — the only copy of this material once Squarespace lapses.

# Generated: link to the archive, recreated by `npm run photos`.
public/photos

# Fonts are copied from node_modules by `npm run fonts` but committed,
# so the site builds without a network round-trip.
!public/fonts

# Generated search index, mirrored for dev by `npm run index`.
public/pagefind

# Promoted inbox originals are kept locally, not in the repo.
content/inbox/promoted

# Generated share cards, rebuilt by `npm run og` during the build.
public/og

# Copied in on demand by `npm run a11y:prep` for local axe audits; never shipped.
public/_axe.js

# Generated readings. Regenerate with `npm run audio`; masters belong on R2,
# not in git - 19.7 hours of narration is 550 MB as mp3.
public/audio
