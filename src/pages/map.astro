---
/**
 * §7.4 — the world view.
 *
 * Built as a static SVG at build time, not a tile map. Three reasons, in order:
 *
 *  1. There are no coordinates in the archive. Squarespace and Google both
 *     stripped GPS from every one of the 755 images (PHASE-0-REPORT.md §3), and
 *     there are no GPX tracks. Country-level is the finest granularity the data
 *     honestly supports, and a slippy map would imply precision we do not have.
 *  2. It needs no tile provider, no API key, and no third-party request.
 *  3. It renders and reads with JavaScript disabled.
 *
 * The one piece of JavaScript on this page draws leader lines from a timeline
 * bar to the countries that trip visited. It is pure enhancement — with it off,
 * the map and the timeline are both still complete and clickable. §3 excepts the
 * maps from the no-JS rule, and this is the whole of what that exception buys.
 *
 * Since 2026-11-02 that static map is the fallback. Where WebGL is available,
 * src/scripts/world-globe.ts replaces it with a full-screen globe (tiles,
 * relief, an icon wherever an entry says something happened, a filtering
 * legend, a tour) fed by /map-data.json. Entry places now exist — pinned to the
 * town or camp each entry names — so the "no coordinates" reason above is
 * history; the SVG stays because it costs nothing and never fails.
 */
import { getCollection } from 'astro:content';
import { feature } from 'topojson-client';
import { geoNaturalEarth1, geoPath, geoGraticule10 } from 'd3-geo';
import world from 'world-atlas/countries-110m.json';
import Base from '../layouts/Base.astro';
import Timeline from '../components/Timeline.astro';
import { COUNTRY_NAMES, COUNTRY_NUMERIC, POINT_MARKERS } from '../data/trip-meta.ts';
import { beenTo, yearSpans } from '../data/been-to.ts';
import { KIND_ORDER, KIND_ICONS, KIND_LABELS, kindsOf, type Kind } from '../lib/journey.ts';
import { tripIdOf, entryCounts } from '../lib/entries.ts';

const allTrips = await getCollection('trips');
const now = new Date();
/*
 * A trip counts on the map once it has started. One that's only planned (a trip
 * started in the admin ahead of time) is on the timeline, outlined, but doesn't
 * shade its countries or add to the count before they get there.
 */
const trips = allTrips.filter((t) => t.data.dateStart <= now);
const counts = await entryCounts();
/** Every country they've been to, from the travel log; trips with entries are a subset. */
const been = beenTo(now);

/** numeric id → the trips that touched it */
const visited = new Map<string, typeof trips>();
for (const t of trips) {
  for (const code of t.data.countries) {
    const num = COUNTRY_NUMERIC[code];
    if (!num) continue;
    visited.set(num, [...(visited.get(num) ?? []), t]);
  }
}
const alphaOf = new Map(Object.entries(COUNTRY_NUMERIC).map(([a, n]) => [n, a]));

const tripsIn = (code: string) => trips.filter((t) => t.data.countries.includes(code));
/** "been 2005, 2009, 2012–14" — or nothing, when the log has no dates for it. */
const beenNote = (code: string) => (been[code]?.length ? `been ${yearSpans(been[code])}` : '');
/** Hover text for a country: its trips with entries first, then every year they were there. */
function titleOf(code: string, fallback = code) {
  const name = COUNTRY_NAMES[code] ?? fallback;
  const ts = tripsIn(code);
  const parts = ts.length
    ? [`${ts.length} ${ts.length === 1 ? 'trip' : 'trips'} written up: ${ts.map((t) => t.data.year).sort().join(', ')}`, beenNote(code)]
    : [beenNote(code) || 'been, date not recorded', 'no entries yet'];
  return `${name} — ${parts.filter(Boolean).join(' · ')}`;
}

const W = 1000;
const H = 500;
const fc = feature(world as never, (world as never as { objects: { countries: unknown } }).objects.countries) as unknown as {
  features: { id?: string; properties?: { name?: string } }[];
};
const projection = geoNaturalEarth1().fitSize([W, H], { type: 'Sphere' } as never);
const path = geoPath(projection);

const shapes = fc.features.map((f) => {
  const id = String(f.id ?? '');
  const ts = visited.get(id);
  const c = path.centroid(f as never);
  const alpha = alphaOf.get(id) ?? null;
  return {
    id,
    d: path(f as never) ?? '',
    name: f.properties?.name ?? '',
    trips: ts ?? [],
    alpha,
    /** Been there, with no entries to link to. */
    beenOnly: !ts && !!alpha && alpha in been,
    cx: Number.isFinite(c[0]) ? c[0] : null,
    cy: Number.isFinite(c[1]) ? c[1] : null,
  };
}).filter((s) => s.d);

const graticule = path(geoGraticule10() as never) ?? '';
const sphere = path({ type: 'Sphere' } as never) ?? '';

/** Countries with entries — the ones that link to a places page. */
const writtenCodes = [...new Set(trips.flatMap((t) => t.data.countries))];
const allCodes = [...new Set([...writtenCodes, ...Object.keys(been)])];

/*
 * Singapore, Andorra, Liechtenstein and the Maldives are below the 110m
 * dataset's size threshold and Hong Kong is folded into China, so they would
 * silently vanish. They get point markers instead.
 */
const drawn = new Set(shapes.filter((s) => (s.trips.length > 0 || s.beenOnly) && s.alpha).map((s) => s.alpha as string));
const points = allCodes
  .filter((c) => !drawn.has(c) && POINT_MARKERS[c])
  .map((c) => {
    const [x, y] = projection(POINT_MARKERS[c]) ?? [0, 0];
    return { code: c, name: COUNTRY_NAMES[c] ?? c, x, y, trips: tripsIn(c) };
  });

const stillMissing = allCodes.filter((c) => !drawn.has(c) && !POINT_MARKERS[c]);
const visitedCount = drawn.size + points.length;

/** Anchor points the connector lines aim at, keyed by country code — including
 *  countries an upcoming trip will visit, which aren't shaded yet. */
const aimedAt = new Set([...allCodes, ...allTrips.flatMap((t) => t.data.countries)]);
const anchors = [
  ...shapes
    .filter((s) => s.alpha && aimedAt.has(s.alpha) && s.cx != null && s.cy != null)
    .map((s) => ({ code: s.alpha as string, x: s.cx as number, y: s.cy as number })),
  ...points.map((p) => ({ code: p.code, x: p.x, y: p.y })),
];

/*
 * The timeline's second lane: months in the travel log that no written-up trip
 * covers — the trip has to name the country and span the month. One dot per
 * month, however many countries it took in.
 */
const monthOf = (d: Date) => d.toISOString().slice(0, 7);
const covered = (code: string, month: string) =>
  tripsIn(code).some((t) => monthOf(t.data.dateStart) <= month && month <= monthOf(t.data.dateEnd));
const byMonth = new Map<string, string[]>();
for (const [code, months] of Object.entries(been)) {
  for (const m of months) if (!covered(code, m)) byMonth.set(m, [...(byMonth.get(m) ?? []), code]);
}
const listOf = (names: string[]) =>
  names.length < 2 ? names.join('') : `${names.slice(0, -1).join(', ')} & ${names[names.length - 1]}`;
const visits = [...byMonth.entries()].map(([month, codes]) => {
  const sortedCodes = [...codes].sort((a, b) => (COUNTRY_NAMES[a] ?? a).localeCompare(COUNTRY_NAMES[b] ?? b));
  return { month, countries: sortedCodes, label: listOf(sortedCodes.map((c) => COUNTRY_NAMES[c] ?? c)) };
});

/*
 * The globe's legend: one row per kind of event, with how many located entries
 * carry it. The everyday kinds start switched off so the globe opens on the
 * stories — dives, summits, near misses, Beth crying — not on every lunch.
 */
const located = (await getCollection('entries', ({ data }) => !data.draft && data.location?.lat != null))
  .filter((e) => trips.some((t) => t.id === tripIdOf(e)));
const kindCount = (k: Kind) => located.filter((e) => kindsOf(e).includes(k)).length;
const QUIET: Kind[] = ['food', 'culture', 'history', 'water', 'weather', 'people', 'city', 'transport', 'logistics', 'rest-day'];
const kinds = KIND_ORDER.map((k) => ({ k, icon: KIND_ICONS[k], label: KIND_LABELS[k], n: kindCount(k), on: !QUIET.includes(k) }))
  .filter((x) => x.n > 0 || x.k === 'diving');
/*
 * The line over the globe is voice, and voice is theirs — so it lives here as
 * one obvious line to change.
 */
const HEADLINE = "Everywhere we've been";
const globeConfig = {
  icons: KIND_ICONS,
  labels: KIND_LABELS,
  order: KIND_ORDER,
  defaultOff: QUIET,
};
---

<Base
  title="Map"
  description={`Every country Andy and Beth have been to — ${allCodes.length} of them, ${writtenCodes.length} written about across ${trips.length} trips.`}
>
  {/*
    The globe stage. Without JavaScript (or WebGL) only the heading shows here and
    the static SVG map below does the work; once the globe is live the stage
    fills the screen and the SVG steps aside (see [data-live] in the styles).
  */}
  <section class="stage" data-globe aria-label="Interactive globe">
    {/*
      Before anything paints: where the globe can run, go straight to its full-screen
      stage and keep the flat map hidden, so it doesn't flash up first. If the globe
      fails, or hasn't drawn within 15 s, world-globe.ts (or the timer here) puts the
      flat map back. Same WebGL test as webglOk() in map-kit.ts.
    */}
    <script is:inline>
      (function () {
        try {
          var c = document.createElement('canvas');
          if (!(c.getContext('webgl2') || c.getContext('webgl'))) return;
        } catch (e) { return; }
        var stage = document.currentScript.parentElement;
        var root = document.documentElement;
        stage.setAttribute('data-live', '');
        root.setAttribute('data-globe-soon', '');
        // The panel opens folded on a phone, or however it was last left.
        var side = null;
        try { side = localStorage.getItem('map-side'); } catch (e) {}
        if (side ? side === 'folded' : matchMedia('(max-width: 700px)').matches) stage.setAttribute('data-side', 'folded');
        setTimeout(function () {
          if (stage.querySelector('canvas')) return;
          stage.removeAttribute('data-live');
          root.removeAttribute('data-globe-soon');
        }, 15000);
      })();
    </script>
    <script type="application/json" id="globe-config" set:html={JSON.stringify(globeConfig)} />
    <div class="stage__map" data-globe-map></div>

    {/*
      One panel for everything said and switched over the globe. Without the globe it
      is just the page's heading; with it, it sits at the left, folds away to its top
      bar, and keeps what the globe shows in two tabs rather than one long list.
    */}
    <div class="side">
      <div class="side__bar">
        <p class="mono side__kicker">Map<span class="side__count"> · {allCodes.length} countries</span></p>
        <button type="button" class="side__fold" data-side-fold aria-expanded="true" aria-controls="side-body">
          <span class="sr" data-side-fold-label>Hide the panel</span>
          <span class="side__chev" aria-hidden="true">‹</span>
        </button>
      </div>
      <div class="side__body" id="side-body">
        <header class="head">
          <h1 class="display">{HEADLINE}</h1>
          <p class="head__note">
            <strong>{allCodes.length} countries</strong> so far. {writtenCodes.length} have stories.
            <span class="head__static"> Hover a country to see when they were there, or a trip on the
            timeline to see everywhere it went.</span>
          </p>
          <p class="stage__buttons">
            <button type="button" class="mono stage__btn" data-globe-tour>▶ Tour the trips</button>
            <button type="button" class="mono stage__btn stage__btn--quiet" data-globe-reset>Reset view</button>
          </p>
        </header>

        <div class="tabs" role="tablist" aria-label="What the globe shows">
          <button type="button" role="tab" class="mono tabs__tab" id="tab-layers" aria-controls="pane-layers" aria-selected="true" data-tab>Layers</button>
          <button type="button" role="tab" class="mono tabs__tab" id="tab-happened" aria-controls="pane-happened" aria-selected="false" tabindex="-1" data-tab>What happened</button>
        </div>

        <div class="pane" id="pane-layers" role="tabpanel" aria-labelledby="tab-layers">
          <p class="mono pane__head">Places</p>
          <ul class="rows">
            <li>
              <label class="row">
                <input type="checkbox" value="places-written" data-layer-toggle checked />
                <span class="row__icon" aria-hidden="true"><span class="key__dot"></span></span>
                <span class="row__label">Written from</span>
                <span class="mono row__n" data-places-written-n></span>
              </label>
            </li>
            <li>
              <label class="row">
                <input type="checkbox" value="places-been" data-layer-toggle checked />
                <span class="row__icon" aria-hidden="true"><span class="key__dot key__dot--been"></span></span>
                <span class="row__label">Been, not written yet</span>
                <span class="mono row__n" data-places-been-n></span>
              </label>
            </li>
          </ul>
          <p class="mono pane__head">Also on the globe</p>
          <ul class="rows">
            <li data-ig-row hidden>
              <label class="row">
                <input type="checkbox" value="instagram" data-layer-toggle checked />
                <span class="row__icon" aria-hidden="true">📷</span>
                <span class="row__label">Photos</span>
                <span class="mono row__n" data-ig-n></span>
              </label>
            </li>
            <li>
              <label class="row">
                <input type="checkbox" value="names" data-layer-toggle checked />
                <span class="row__icon key__aa" aria-hidden="true">Aa</span>
                <span class="row__label">Country names</span>
                <span class="mono row__n"></span>
              </label>
            </li>
            <li>
              <label class="row">
                <input type="checkbox" value="states" data-layer-toggle checked />
                <span class="row__icon" aria-hidden="true"><span class="key__swatch key__swatch--been"></span></span>
                <span class="row__label">US states</span>
                <span class="mono row__n" data-states-n></span>
              </label>
            </li>
          </ul>
          <p class="mono pane__head">Country shading</p>
          <ul class="shade">
            <li><span class="key__swatch key__swatch--written"></span>Written up</li>
            <li><span class="key__swatch key__swatch--been"></span>Been, no entries yet</li>
          </ul>
        </div>

        <div class="pane" id="pane-happened" role="tabpanel" aria-labelledby="tab-happened" hidden>
          <p class="mono pane__head">
            Tap to show or hide
            <button type="button" class="pane__all" data-kinds-all>all / none</button>
          </p>
          <ul class="chips">
            {kinds.map((x) => (
              <li>
                <label class="chip" title={x.label}>
                  <input type="checkbox" value={x.k} data-kind-toggle checked={x.on} data-label={x.label} data-n={x.n} />
                  <span class="chip__icon" aria-hidden="true">{x.icon}</span>
                  <span class="sr">{x.label}</span>
                  <span class="mono chip__n">{x.k === 'diving' && !x.n ? '' : x.n}</span>
                </label>
              </li>
            ))}
          </ul>
          <p class="mono pane__say" data-kind-say aria-live="polite">Point at an icon to see what it marks</p>
          <p class="pane__note">Each icon sits where the entry says it happened, pinned to the town, camp or park — not a GPS track.</p>
        </div>
      </div>
    </div>

    <aside class="gpanel" data-globe-panel hidden aria-live="polite"></aside>
    <p class="mono gcaption" data-globe-caption hidden aria-live="polite"></p>
    {/* Shown once, to someone who hasn't been here before; it goes as soon as they touch the globe. */}
    <p class="mono ghint" data-globe-hint hidden>Drag to spin · click a country · tap an icon</p>
  </section>

  <figure class="mapwrap" data-map-wrap>
    {/* Sized to the wrapper in pixels by the script; empty and invisible without it. */}
    <svg class="mapwrap__overlay" data-map-overlay aria-hidden="true"></svg>
    <span class="mapwrap__callout mono" data-map-callout hidden></span>

    {/* Labelled <nav>, not role="img": the countries are links, and declaring the
        whole map a single graphic conflicts with that (axe: nested-interactive). */}
    <nav aria-label={`World map with ${visitedCount} countries marked; the ${writtenCodes.length} with entries link to them`}>
    <svg viewBox={`0 0 ${W} ${H}`} focusable="false" class="worldmap">
      <path d={sphere} class="m-sphere" />
      <path d={graticule} class="m-grat" />
      {shapes.map((s) => (
        s.trips.length > 0 && s.alpha ? (
          <a href={`/places/${s.alpha.toLowerCase()}/`} class="m-link" data-cc-link={s.alpha}>
            <title>{titleOf(s.alpha, s.name)}</title>
            <path d={s.d} class="m-country m-country--visited" />
          </a>
        ) : s.beenOnly && s.alpha ? (
          /* Nothing to link to yet, so a plain group — but it still lights up
             when a dot on the timeline traces to it. */
          <g class="m-been" data-cc-link={s.alpha}>
            <title>{titleOf(s.alpha, s.name)}</title>
            <path d={s.d} class="m-country m-country--been" />
          </g>
        ) : (
          <path d={s.d} class="m-country" />
        )
      ))}

      {points.map((p) => (
        p.trips.length > 0 ? (
          <a href={`/places/${p.code.toLowerCase()}/`} class="m-link" data-cc-link={p.code}>
            <title>{titleOf(p.code)}</title>
            <circle cx={p.x} cy={p.y} r="4" class="m-point" />
          </a>
        ) : (
          <g class="m-been" data-cc-link={p.code}>
            <title>{titleOf(p.code)}</title>
            <circle cx={p.x} cy={p.y} r="3.5" class="m-point m-point--been" />
          </g>
        )
      ))}

      {/* Invisible targets the leader lines aim at. Kept inside the map's own
          coordinate space so the script can read their screen position directly
          instead of re-implementing the projection. */}
      {anchors.map((a) => (
        <circle class="m-anchor" data-cc={a.code} cx={a.x} cy={a.y} r="0.5" />
      ))}
    </svg>
    </nav>

    <figcaption class="mono">
      <span class="key">
        <span class="key__item"><span class="key__swatch key__swatch--written"></span>Written up — click through</span>
        <span class="key__item"><span class="key__swatch key__swatch--been"></span>Been, no entries yet</span>
      </span>
      Country level, not route level — there is no GPS in the archive to plot.
      {points.length > 0 && ` ${listOf(points.map((p) => p.name))} marked as points; too small to draw at this scale.`}
      {stillMissing.length > 0 && ` Not shown: ${stillMissing.map((c) => COUNTRY_NAMES[c] ?? c).join(', ')}.`}
    </figcaption>

    <!-- The map answers where; this answers when, on the same dark surface. -->
    <div class="tlwrap">
      <h2 class="mono tlwrap__head">And when</h2>
      <Timeline
        trips={allTrips.map((t) => ({
          id: t.id,
          title: t.data.title,
          shortTitle: t.data.shortTitle,
          year: t.data.year,
          dateStart: t.data.dateStart,
          dateEnd: t.data.dateEnd,
          entries: counts.get(t.id) ?? 0,
          countries: t.data.countries,
          upcoming: t.data.dateStart > now,
        }))}
        visits={visits}
      />
    </div>
  </figure>

</Base>

<script>
  import '../scripts/world-globe.ts';

  /*
   * The panel over the globe: folding it away, its two tabs, and the line that
   * names an icon. None of this touches the map itself — the switches and chips
   * are ordinary checkboxes that world-globe.ts listens to.
   */
  const stage = document.querySelector<HTMLElement>('[data-globe]');
  if (stage) {
    const remember = (key: string, value: string) => { try { localStorage.setItem(key, value); } catch { /* private window */ } };
    const recall = (key: string) => { try { return localStorage.getItem(key); } catch { return null; } };

    // ---- folding ----
    const fold = stage.querySelector<HTMLButtonElement>('[data-side-fold]');
    const foldLabel = stage.querySelector<HTMLElement>('[data-side-fold-label]');
    const sync = () => {
      const folded = stage.dataset.side === 'folded';
      fold?.setAttribute('aria-expanded', String(!folded));
      if (foldLabel) foldLabel.textContent = folded ? 'Show the panel' : 'Hide the panel';
    };
    fold?.addEventListener('click', () => {
      const folded = stage.dataset.side !== 'folded';
      if (folded) stage.dataset.side = 'folded'; else delete stage.dataset.side;
      remember('map-side', folded ? 'folded' : 'open');
      sync();
    });
    sync();

    // ---- tabs ----
    const tabs = [...stage.querySelectorAll<HTMLButtonElement>('[data-tab]')];
    const pick = (tab: HTMLButtonElement, focus = false) => {
      for (const t of tabs) {
        const on = t === tab;
        t.setAttribute('aria-selected', String(on));
        t.tabIndex = on ? 0 : -1;
        const pane = document.getElementById(t.getAttribute('aria-controls')!);
        if (pane) pane.hidden = !on;
      }
      if (focus) tab.focus();
      remember('map-tab', tab.id);
    };
    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => pick(tab));
      tab.addEventListener('keydown', (ev) => {
        if (ev.key !== 'ArrowLeft' && ev.key !== 'ArrowRight') return;
        ev.preventDefault();
        pick(tabs[(i + (ev.key === 'ArrowRight' ? 1 : tabs.length - 1)) % tabs.length], true);
      });
    });
    const last = tabs.find((t) => t.id === recall('map-tab'));
    if (last) pick(last);

    // ---- which icon is that? ----
    const say = stage.querySelector<HTMLElement>('[data-kind-say]');
    if (say) {
      const idle = say.textContent ?? '';
      const name = (box: HTMLInputElement) => {
        const n = Number(box.dataset.n);
        const count = n ? ` · ${n} ${n === 1 ? 'entry' : 'entries'}` : '';
        say.textContent = `${box.dataset.label}${count}${box.checked ? '' : ' · hidden'}`;
        say.classList.add('is-live');
      };
      const hush = () => { say.textContent = idle; say.classList.remove('is-live'); };
      stage.querySelectorAll<HTMLInputElement>('[data-kind-toggle]').forEach((box) => {
        const chip = box.closest('label')!;
        chip.addEventListener('pointerenter', () => name(box));
        chip.addEventListener('pointerleave', hush);
        box.addEventListener('focus', () => name(box));
        box.addEventListener('blur', hush);
        // On a phone there is no hover, so a tap says what it just switched.
        box.addEventListener('change', () => name(box));
      });
      stage.querySelector('[data-kinds-all]')?.addEventListener('click', hush);
    }

    // ---- how to use it, shown once ----
    const hint = stage.querySelector<HTMLElement>('[data-globe-hint]');
    if (hint && stage.hasAttribute('data-live') && !recall('map-hint')) {
      hint.hidden = false;
      let gone = false;
      const go = () => {
        if (gone) return;
        gone = true;
        remember('map-hint', '1');
        hint.classList.add('is-going');
        setTimeout(() => { hint.hidden = true; }, 600);
      };
      const map = stage.querySelector<HTMLElement>('[data-globe-map]');
      for (const ev of ['pointerdown', 'wheel', 'keydown'] as const) map?.addEventListener(ev, go, { once: true, passive: true });
      stage.querySelector('[data-globe-tour]')?.addEventListener('click', go, { once: true });
      setTimeout(go, 14000);
    }
  }
</script>

<script is:inline>
  /*
   * Leader lines from a timeline bar to the countries that trip visited.
   * Progressive enhancement: everything here is additive, and the page is fully
   * usable if it never runs.
   */
  (function () {
    var wrap = document.querySelector('[data-map-wrap]');
    if (!wrap) return;
    var overlay = wrap.querySelector('[data-map-overlay]');
    var callout = wrap.querySelector('[data-map-callout]');
    // Trip bars, and the travel-log dots in the lane beneath them.
    var bars = [].slice.call(wrap.querySelectorAll('.tl__bar, .tl__visit'));
    if (!overlay || !callout || !bars.length) return;

    var NS = 'http://www.w3.org/2000/svg';
    var anchors = {};
    [].forEach.call(wrap.querySelectorAll('[data-cc]'), function (el) {
      anchors[el.getAttribute('data-cc')] = el;
    });
    var reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    var active = null;

    function clear() {
      active = null;
      while (overlay.firstChild) overlay.removeChild(overlay.firstChild);
      callout.hidden = true;
      wrap.removeAttribute('data-tracing');
      bars.forEach(function (b) { b.removeAttribute('data-linked'); });
      [].forEach.call(wrap.querySelectorAll('[data-cc-link]'), function (el) {
        el.removeAttribute('data-lit');
      });
    }

    function draw(bar) {
      // Once the globe is up it flies to the trip instead; the SVG is hidden.
      if (wrap.hasAttribute('data-globe-live')) return;
      if (active === bar) return;
      clear();
      active = bar;

      var codes = (bar.getAttribute('data-countries') || '').split(',').filter(Boolean);
      if (!codes.length) return;

      var wr = wrap.getBoundingClientRect();
      var br = bar.getBoundingClientRect();
      var x0 = br.left - wr.left + br.width / 2;
      var y0 = br.top - wr.top;

      overlay.setAttribute('width', wr.width);
      overlay.setAttribute('height', wr.height);
      overlay.setAttribute('viewBox', '0 0 ' + wr.width + ' ' + wr.height);

      var drew = 0;
      codes.forEach(function (cc) {
        var a = anchors[cc];
        if (!a) return;
        var ar = a.getBoundingClientRect();
        var x1 = ar.left - wr.left + ar.width / 2;
        var y1 = ar.top - wr.top + ar.height / 2;

        var line = document.createElementNS(NS, 'path');
        // A gentle curve rather than a straight rule, so lines crossing the
        // map stay distinguishable from the graticule.
        var my = y0 + (y1 - y0) * 0.55;
