---
/**
 * §7.1 — the global nav, collapsed from fourteen trip links to four
 * destinations, and rendered exactly once in the DOM. The trip list lives on
 * /trips, which is the only place it can grow without breaking anything.
 */
const path = Astro.url.pathname;
const items = [
  { href: '/trips/', label: 'Trips' },
  { href: '/map/', label: 'Map' },
  { href: '/archive/', label: 'Archive' },
  { href: '/about/', label: 'About' },
];
const isCurrent = (href: string) => path === href || path.startsWith(href);
---

<header class="nav">
  <a href="/" class="nav__mark">
    <span class="nav__mark-a display">Cleatus</span>
    <span class="nav__mark-b mono">&amp; the West Virginian</span>
  </a>
  <nav aria-label="Primary">
    <ul>
      {items.map((i) => (
        <li>
          <a href={i.href} class="mono" aria-current={isCurrent(i.href) ? 'page' : undefined}>
            {i.label}
          </a>
        </li>
      ))}
      <!--
        Search sits apart from the four destinations rather than becoming a fifth
        one: it is an action, not a place. `/` focuses it from anywhere (§7.5).
      -->
      <li class="nav__search">
        <a href="/search/" class="mono" aria-current={isCurrent('/search/') ? 'page' : undefined}>
          Search <kbd aria-hidden="true">/</kbd>
        </a>
      </li>
    </ul>
  </nav>
</header>

<style>
  .nav {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
    padding: 1.1rem clamp(1rem, 4vw, 3rem);
    background: var(--color-ink);
    color: var(--color-snow);
  }
  .nav__mark {
    display: flex;
    align-items: baseline;
    gap: 0.55rem;
    text-decoration: none;
    flex-wrap: wrap;
  }
  .nav__mark-a {
    font-size: 1.0625rem;
    font-stretch: 118%;
    letter-spacing: 0.01em;
  }
  .nav__mark-b {
    color: var(--color-stone-on-dark);
    font-size: 0.6875rem;
  }
  .nav ul {
    display: flex;
    gap: clamp(0.9rem, 2.5vw, 1.9rem);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .nav a {
    color: var(--color-snow);
    text-decoration: none;
    padding-bottom: 2px;
    border-bottom: 1px solid transparent;
    transition: border-color 150ms ease, color 150ms ease;
  }
  .nav nav a:hover {
    color: var(--color-rime);
    border-bottom-color: var(--color-rime);
  }
  /* The beam marks where you are. */
  .nav nav a[aria-current='page'] {
    color: var(--color-headlamp);
    border-bottom-color: var(--color-headlamp);
  }

  .nav__search a {
    color: var(--color-stone-on-dark);
  }
  .nav__search kbd {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    border: 1px solid currentColor;
    border-radius: 2px;
    padding: 0 0.25rem;
    margin-left: 0.15rem;
    opacity: 0.75;
  }
  @media (max-width: 620px) {
    .nav__search kbd { display: none; }
  }
</style>
